{% extends "_layouts/_layout_notification.html.twig" %}

{% block title %}Café Virtuel - Votre Espace de Détente{% endblock %}

{% block stylesheets %}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #333;
            min-height: 100vh;
        }

        /* Header */
        .header {
            background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.95;
        }

        /* Navigation */
        .nav {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .nav button {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: 2px solid white;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .nav button:hover {
            background: white;
            color: #8B4513;
            transform: translateY(-2px);
        }

        /* Main Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Sections */
        .section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section h2 {
            color: #8B4513;
            margin-bottom: 20px;
            font-size: 2em;
            border-bottom: 3px solid #D2691E;
            padding-bottom: 10px;
        }

        /* Menu Grid */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .menu-item {
            background: linear-gradient(135deg, #fff5f1 0%, #ffe4d6 100%);
            border-left: 5px solid #8B4513;
            padding: 20px;
            border-radius: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            position: relative;
        }

        .menu-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            background: linear-gradient(135deg, #fff0e6 0%, #ffd9c2 100%);
        }

        .menu-item h3 {
            color: #8B4513;
            margin-bottom: 10px;
            font-size: 1.3em;
        }

        .menu-item .description {
            color: #666;
            font-size: 0.9em;
            margin-bottom: 10px;
        }

        /* Order controls */
        .qty-input { padding:6px;border:1px solid #ddd;border-radius:6px;width:80px }
        .order-btn { background:#8B4513;color:#fff;padding:8px 12px;border-radius:8px;border:none;cursor:pointer }

        /* Modal improvements */
        #cartModal { align-items:center; justify-content:center; }
        #cartModal > div { width: min(720px, 96%); }

        .menu-item .price {
            color: #D2691E;
            font-weight: bold;
            font-size: 1.2em;
        }

        .menu-item .temperature {
            color: #999;
            font-size: 0.85em;
            margin-top: 8px;
            font-style: italic;
        }

        .fidelity-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #e07b1a;
            color: #fff;
            padding: 4px 10px;
            border-radius: 16px;
            font-size: 0.95em;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            z-index: 2;
        }

        /* Features Section */
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .feature-card {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .feature-card .icon {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .feature-card h3 {
            color: #2e7d32;
            margin-bottom: 10px;
        }

        .feature-card p {
            color: #555;
            font-size: 0.9em;
        }

        /* Chat Section */
        .chat-container {
            background: linear-gradient(135deg, #f5f5f5 0%, #efefef 100%);
            border-radius: 10px;
            padding: 20px;
            height: 400px;
            display: flex;
            flex-direction: column;
            margin-top: 20px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 15px;
            padding: 10px;
            background: white;
            border-radius: 8px;
        }

        .message {
            margin-bottom: 10px;
            padding: 10px 15px;
            border-radius: 8px;
            max-width: 80%;
            word-wrap: break-word;
        }

        .message.user {
            background: #8B4513;
            color: white;
            margin-left: auto;
        }

        .message.bot {
            background: #e0e0e0;
            color: #333;
            margin-right: auto;
        }

        .chat-input {
            display: flex;
            gap: 10px;
        }

        .chat-input input {
            flex: 1;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
        }

        .chat-input button {
            background: #8B4513;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .chat-input button:hover {
            background: #A0522D;
        }

        /* About Section */
        .about-content {
            line-height: 1.8;
            color: #555;
        }

        .about-content p {
            margin-bottom: 15px;
        }

        /* Footer */
        .footer {
            background: #1a1a2e;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
            box-shadow: 0 -4px 6px rgba(0, 0, 0, 0.3);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header h1 {
                font-size: 2em;
            }

            .menu-grid {
                grid-template-columns: 1fr;
            }

            .nav {
                flex-direction: column;
            }

            .nav button {
                width: 100%;
            }

            .chat-container {
                height: 300px;
            }
            /* Stack controls on small screens for easier tapping */
            .menu-item div[style*="display:flex"][style*="gap:8px"] { flex-direction:column; align-items:flex-start }
            .qty-input { width:100%; max-width:120px }
            .order-btn { width:100%; }
        }

        /* Animations */
        .coffee-animation {
            display: inline-block;
            animation: steam 2s infinite;
        }

        @keyframes steam {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        /* Category filter styles */
        .category-filter-wrapper {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-top: 18px;
        }

        .category-filter-control {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(180deg,#fff 0,#fff5f1 100%);
            border: 1px solid #e6dccf;
            padding: 6px 8px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .category-filter {
            border: none;
            background: transparent;
            font-size: 0.95em;
            padding: 6px 8px;
            appearance: none;
            -webkit-appearance: none;
            color: #333;
        }

        .category-filter:disabled { opacity: 0.6; }

        .category-clear-btn {
            background: transparent;
            border: none;
            color: #8B4513;
            font-weight: bold;
            cursor: pointer;
            padding: 4px 6px;
            border-radius: 6px;
        }

        .category-clear-btn:hover { background: rgba(139,69,19,0.06); }

        .loader-spinner {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid rgba(0,0,0,0.08);
            border-top-color: #8B4513;
            animation: spin 0.9s linear infinite;
            display: none;
        }

        .loader-spinner.visible { display: inline-block; }

        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <div class="header">
        <h1>☕ Café Virtuel</h1>
        <p>Votre espace de détente et de convivialité en ligne</p>
        <div class="nav">
            <button type="button" onclick="showSection('accueil')">Accueil</button>
            <button type="button" onclick="showSection('menu')">Menu</button>

            <button type="button" onclick="window.location.href='{{ path('profile_redirect') }}'">Profile</button>

            <button type="button" onclick="showSection('events')">Événements</button>

            <button type="button" onclick="showSection('chat')">Chat</button>
            <button type="button" onclick="showSection('about')">À Propos</button>
        </div>

        <div style="position: absolute; right: 20px; top: 18px; display:flex; gap:8px; align-items:center;">
            {% if app.user is defined and app.user is not null %}
                <a href="{{ path('app_logout') }}" class="btn" style="background:#c0392b;color:#fff;padding:8px 12px;border-radius:6px;text-decoration:none;">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn" style="background:transparent;color:#fff;border:2px solid #fff;padding:8px 12px;border-radius:6px;text-decoration:none;">Se Connecter</a>
            {% endif %}
            <button id="cartButton" style="background:#fff;color:#8B4513;padding:8px 12px;border-radius:6px;border:none;cursor:pointer;">🛒 Panier (<span id="cartCount">0</span>)</button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <!-- Accueil Section -->
        <div class="section active" id="accueil">
            <h2>Bienvenue dans notre Café Virtuel</h2>
            <p style="font-size: 1.1em; color: #555; margin-bottom: 30px;">
                Rejoignez-nous pour un moment de détente, de conversation et de camaraderie. 
                Notre café virtuel est ouvert 24h/24 pour vous accueillir!
            </p>

            <div class="features">
                <div class="feature-card">
                    <div class="icon">🌍</div>
                    <h3>Accessible</h3>
                    <p>Accessible depuis n'importe où, n'importe quand</p>
                </div>
                <div class="feature-card">
                    <div class="icon">👥</div>
                    <h3>Communauté</h3>
                    <p>Rencontrez des personnes du monde entier</p>
                </div>
                <div class="feature-card">
                    <div class="icon">☕</div>
                    <h3>Qualité</h3>
                    <p>Les meilleures boissons virtuelles</p>
                </div>
                <div class="feature-card">
                    <div class="icon">💬</div>
                    <h3>Convivialité</h3>
                    <p>Discutez et partagez vos moments</p>
                </div>
            </div>
        </div>

        <!-- Menu Section -->
        <div class="section" id="menu">
            <h2>✨ Suggestions de l'Admin</h2>
            <div id="suggestions-area" style="margin-bottom:20px;">
                <div style="padding:10px; color:#666; background:#fff; border-radius:8px;">Suggestions disponibles via localStorage (admin)</div>
            </div>

            <h2>Notre Menu</h2>

            <div class="category-filter-wrapper">
                <label for="category-filter" style="color:#555; font-weight:600;">Filtrer par catégorie:</label>
                <div class="category-filter-control">
                    <select id="category-filter" class="category-filter" aria-label="Filtrer par catégorie" onchange="filterMenu()">
                        <option value="">Toutes ({{ menuItems|length }})</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                    <button id="clear-filter" class="category-clear-btn" title="Réinitialiser le filtre" onclick="document.getElementById('category-filter').value=''; filterMenu();">✕</button>
                </div>
            </div>

            <div id="menu-grid" class="menu-grid" style="margin-top:20px;">
                {% if menuItems is empty %}
                    <div style="padding:20px; color:#666">Aucun produit trouvé</div>
                {% else %}
                    {% for item in menuItems %}
                        <div class="menu-item" data-category="{{ item.categorie ? item.categorie.id : '' }}" data-id="{{ item.id }}">
                            {% if item.fidelityPoints and item.fidelityPoints > 0 %}
                                <div class="fidelity-badge">{{ item.fidelityPoints }} ⭐</div>
                            {% endif %}
                            {% if item.image %}
                                <div style="margin-bottom:10px;">
                                    <img src="{{ item.image }}" alt="{{ item.name }}" style="width:100%;height:140px;object-fit:cover;border-radius:8px;">
                                </div>
                            {% endif %}
                            <h3>{{ item.name }}</h3>
                            <p class="description">{{ item.description ?? '' }}</p>
                            <p class="price">{{ item.price|number_format(2, '.', '') }} DT</p>
                            {% if item.categorie %}
                                <p style="color:#999; font-size:0.9em">{{ item.categorie.name }}</p>
                            {% endif %}

                            <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
                                <input type="number" min="1" value="1" class="qty-input" aria-label="Quantité pour {{ item.name }}" style="width:80px;padding:6px;border:1px solid #ddd;border-radius:6px;">
                                <button type="button" class="order-btn" style="background:#8B4513;color:#fff;padding:8px 12px;border-radius:8px;border:none;cursor:pointer;">Commander</button>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <!-- Events Section -->
        <div class="section" id="events">
            <h2>Événements</h2>
            <p style="color:#555; margin-bottom:12px;">Découvrez nos prochains événements et réservez votre place.</p>
            <div class="menu-grid" style="margin-top:20px;">
                {% if events is empty %}
                    <div style="padding:20px;color:#666">Aucun événement public prévu.</div>
                {% else %}
                    {% for event in events %}
                        <div class="menu-item">
                            {% if event.image %}
                                <div style="margin-bottom:10px;">
                                    <img src="{{ event.image }}" alt="{{ event.title }}" style="width:100%;height:140px;object-fit:cover;border-radius:8px;">
                                </div>
                            {% endif %}
                            <h3>{{ event.title }}</h3>
                            <p class="description">{{ event.description ?? '' }}</p>
                            {% if event.date %}
                                <div style="color:#999;margin-top:8px; font-size:0.95em">📅 {{ event.date|date('Y-m-d') }}</div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        <!-- Chat Section -->
        <div class="section" id="chat">
            <h2>Rejoignez le Chat</h2>
            <p style="color: #555; margin-bottom: 15px;">
                Discutez avec d'autres clients du café virtuel, partagez vos expériences et faites connaissance!
            </p>
            <div class="chat-container">
                <div class="chat-messages" id="chatMessages">
                    <div class="message bot">Bienvenue au Café Virtuel! 👋</div>
                    <div class="message bot">Comment puis-je vous aider aujourd'hui?</div>
                </div>
                <div class="chat-input">
                    <input type="text" id="chatInput" placeholder="Tapez votre message...">
                    <button type="button" onclick="sendMessage()">Envoyer</button>
                </div>
            </div>
        </div>

        <!-- About Section -->
        <div class="section" id="about">
            <h2>À Propos de Nous</h2>
            <div class="about-content">
                <p>
                    <strong>Le Café Virtuel</strong> est un projet communautaire créé pour offrir un espace 
                    de détente et de convivialité en ligne.
                </p>
                <p>
                    Notre mission est de créer un lieu où les gens peuvent se rencontrer, discuter, 
                    partager leurs passions pour le café et simplement profiter d'un moment de détente 
                    en ligne.
                </p>
                <h3 style="color: #8B4513; margin-top: 20px; margin-bottom: 10px;">Nos Valeurs</h3>
                <ul style="margin-left: 20px; color: #555;">
                    <li>🤝 Communauté et entraide</li>
                    <li>☕ Passion pour le café</li>
                    <li>🌍 Inclusivité et diversité</li>
                    <li>💡 Innovation et créativité</li>
                    <li>😊 Bien-être et détente</li>
                </ul>
                <h3 style="color: #8B4513; margin-top: 20px; margin-bottom: 10px;">Horaires</h3>
                <p>Ouvert 24h/24, 7 jours sur 7</p>
                <h3 style="color: #8B4513; margin-top: 20px; margin-bottom: 10px;">Contact</h3>
                <p>Email: info@cafevirtuel.com<br>
                   Téléphone: +33 1 23 45 67 89</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <!-- Cart Modal -->
    <div id="cartModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);align-items:center;justify-content:center;z-index:500;">
        <div style="background:white;border-radius:10px;max-width:720px;width:90%;padding:20px;max-height:80vh;overflow:auto;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                <h3 style="margin:0;color:#8B4513">Votre panier</h3>
                <div>
                    <button id="clearCartBtn" style="background:#c0392b;color:#fff;padding:6px 10px;border-radius:6px;border:none;cursor:pointer;margin-right:8px;">Vider</button>
                    <button id="closeCartBtn" style="background:transparent;color:#333;padding:6px 10px;border-radius:6px;border:1px solid #ccc;cursor:pointer;">Fermer</button>
                </div>
            </div>
            <div id="cartContent" style="display:flex;flex-direction:column;gap:10px;"></div>
            <div style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;">
                <div style="font-weight:700;color:#333">Total: <span id="cartTotal">0.00</span> DT</div>
                <div>
                    <button id="checkoutBtn" style="background:#8B4513;color:#fff;padding:8px 12px;border-radius:8px;border:none;cursor:pointer;">Confirmer la commande</button>
                </div>
            </div>
        </div>
    </div>
    <div class="footer">
        <p>&copy; 2025 Café Virtuel. Tous droits réservés. ☕</p>
        <p>Créé avec ❤️ pour les amateurs de café</p>
    </div>

    <!-- Scripts -->
    <script>
        function showSection(sectionId) {
            // Masquer toutes les sections
            const sections = document.querySelectorAll('.section');
            sections.forEach(section => {
                section.classList.remove('active');
            });

            // Afficher la section sélectionnée
            const activeSection = document.getElementById(sectionId);
            if (activeSection) {
                activeSection.classList.add('active');
                // Scroll to top
                window.scrollTo(0, 0);
            }
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();

            if (message === '') return;

            const chatMessages = document.getElementById('chatMessages');

            // Ajouter le message de l'utilisateur
            const userMsg = document.createElement('div');
            userMsg.className = 'message user';
            userMsg.textContent = message;
            chatMessages.appendChild(userMsg);

            input.value = '';

            // Scroll to bottom
            chatMessages.scrollTop = chatMessages.scrollHeight;

            // Simuler une réponse du bot
            setTimeout(() => {
                const botMsg = document.createElement('div');
                botMsg.className = 'message bot';
                const responses = [
                    'C\'est une excellente question! ☕',
                    'Je suis d\'accord avec vous!',
                    'Vous avez raison, le café est délicieux! 😊',
                    'Merci pour votre participation!',
                    'C\'est vrai, notre café est le meilleur! ☕',
                    'Bonne idée! Avez-vous d\'autres suggestions?'
                ];
                botMsg.textContent = responses[Math.floor(Math.random() * responses.length)];
                chatMessages.appendChild(botMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }, 500);
        }

        // Permettre d'envoyer le message avec la touche Entrée
        document.addEventListener('DOMContentLoaded', function() {
            // Store server-side menu in localStorage for suggestions
            const serverMenu = [
                {% for item in menuItems %}
                {
                    id: {{ item.id }},
                    name: "{{ item.name|e('js') }}",
                    category: "{{ item.categorie ? item.categorie.name|e('js') : '' }}",
                    price: {{ item.price }},
                    description: "{{ item.description|default('')|e('js') }}",
                    image: "{{ item.image|default('')|e('js') }}"
                }{{ not loop.last ? ',' : '' }}
                {% endfor %}
            ];
            try {
                localStorage.setItem('preview_menu', JSON.stringify(serverMenu));
            } catch(e) {
                console.error('Failed to store menu in localStorage:', e);
            }

            const chatInput = document.getElementById('chatInput');
            if (chatInput) {
                chatInput.addEventListener('keypress', function(event) {
                    if (event.key === 'Enter') {
                        sendMessage();
                    }
                });
            }
            // Load suggestions from localStorage if available
            renderSuggestionsFromStorage();
        });

        // Suggestion lists helpers (read from localStorage - set by admin)
        function readSuggestionLists(){ 
            try{ 
                return JSON.parse(localStorage.getItem('preview_suggestion_lists')||'null')||[] 
            }catch(e){ 
                return []; 
            } 
        }
        
        function readMenuFromStorage(){ 
            try{ 
                return JSON.parse(localStorage.getItem('preview_menu')||'null')||[] 
            }catch(e){ 
                return []; 
            } 
        }

        function renderSuggestionsFromStorage(){
            const area = document.getElementById('suggestions-area'); 
            if(!area) return;
            
            const lists = (readSuggestionLists()||[]).filter(l=>!!l.published);
            const menu = readMenuFromStorage();
            
            if(!lists || lists.length === 0){ 
                area.innerHTML = '<div style="padding:10px; color:#666; background:#fff; border-radius:8px;">Aucune suggestion pour le moment.</div>'; 
                return; 
            }

            // flatten products from all published lists
            const seen = new Set();
            const products = [];
            lists.forEach(list => {
                (list.productIds||[]).forEach(id => {
                    const it = menu.find(m=>m.id===id);
                    if(it && !seen.has(it.id)){
                        seen.add(it.id);
                        it._fromListImage = it.image || list.image || null;
                        products.push(it);
                    }
                });
            });

            const placeholder = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300"><rect width="100%" height="100%" fill="#fdebe3"/></svg>');

            const grid = document.createElement('div');
            grid.style.display = 'grid';
            grid.style.gridTemplateColumns = 'repeat(auto-fit,minmax(220px,1fr))';
            grid.style.gap = '18px';

            products.forEach(it => {
                const card = document.createElement('div');
                card.style.background = '#fdebe6';
                card.style.borderRadius = '12px';
                card.style.padding = '14px';
                card.style.position = 'relative';
                card.style.boxShadow = '0 6px 18px rgba(0,0,0,0.04)';
                card.style.borderLeft = '6px solid #8B4513';

                const imgWrap = document.createElement('div');
                imgWrap.style.width = '100%';
                imgWrap.style.height = '120px';
                imgWrap.style.overflow = 'hidden';
                imgWrap.style.borderRadius = '8px';
                imgWrap.style.marginBottom = '12px';
                const img = document.createElement('img');
                img.src = it.image || it._fromListImage || placeholder;
                img.alt = it.name || '';
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.objectFit = 'cover';
                imgWrap.appendChild(img);

                const title = document.createElement('div'); 
                title.textContent = it.name || ''; 
                title.style.fontSize = '1.05em'; 
                title.style.fontWeight = '700'; 
                title.style.color = '#8B4513'; 
                title.style.marginBottom = '6px';
                
                const desc = document.createElement('div'); 
                desc.textContent = it.description || ''; 
                desc.style.color = '#666'; 
                desc.style.fontSize = '0.95em'; 
                desc.style.marginBottom = '10px'; 
                desc.style.maxHeight = '3.2em'; 
                desc.style.overflow = 'hidden'; 
                desc.style.textOverflow = 'ellipsis';

                const foot = document.createElement('div'); 
                foot.style.display = 'flex'; 
                foot.style.flexDirection = 'column'; 
                foot.style.gap = '6px';
                
                const price = document.createElement('div'); 
                price.textContent = (typeof it.price === 'number' ? it.price.toFixed(2).replace('.',',') : String(it.price||'')) + ' DT'; 
                price.style.color = '#e07b1a'; 
                price.style.fontWeight = '700'; 
                price.style.fontSize = '1.05em';
                
                const category = document.createElement('div'); 
                category.textContent = it.categorie_name || it.categorie || ''; 
                category.style.color = '#b07a5a'; 
                category.style.fontSize = '0.9em';

                foot.appendChild(price); 
                foot.appendChild(category);

                card.appendChild(imgWrap);
                card.appendChild(title);
                card.appendChild(desc);
                card.appendChild(foot);

                grid.appendChild(card);
            });

            area.innerHTML = '';
            area.appendChild(grid);
        }

        // Update suggestions when storage changes (admin publishes/edits lists)
        window.addEventListener('storage', function(e){ 
            if(!e) return; 
            if(e.key === 'preview_suggestion_lists' || e.key === 'preview_suggestion_lists_updated_at' || e.key === 'preview_menu'){ 
                try{ 
                    renderSuggestionsFromStorage(); 
                }catch(_){} 
            } 
        });

        // Filter menu items by category
        function filterMenu() {
            const selectedCategory = document.getElementById('category-filter').value;
            const menuItems = document.querySelectorAll('.menu-item[data-category]');
            
            menuItems.forEach(item => {
                const itemCategory = item.getAttribute('data-category');
                if (selectedCategory === '' || itemCategory === selectedCategory) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // --- Cart functionality (localStorage) ---
        function getCart(){
            try{ return JSON.parse(localStorage.getItem('cafe_cart')||'null')||[] }catch(e){ return []; }
        }

        function saveCart(cart){
            try{ localStorage.setItem('cafe_cart', JSON.stringify(cart)); }catch(e){ console.error('Failed to save cart', e); }
            renderCartCount();
        }

        function renderCartCount(){
            const c = getCart();
            const totalQty = c.reduce((s,i)=>s+(i.quantity||0),0);
            const el = document.getElementById('cartCount');
            if(el) el.textContent = String(totalQty);
        }

        function findMenuItemById(id){
            const menu = readMenuFromStorage();
            return menu.find(m=>String(m.id) === String(id));
        }

        function addToCart(itemId, quantity, note){
            const item = findMenuItemById(itemId);
            if(!item) return showNotification('error', 'Produit introuvable');
            const cart = getCart();
            const existing = cart.find(c=>String(c.id)===String(itemId) && c.note === note);
            if(existing){ existing.quantity = (existing.quantity||0) + Number(quantity); }
            else { cart.push({ id: item.id, name: item.name, price: Number(item.price||0), quantity: Number(quantity), image: item.image||'', note: note || '' }); }
            saveCart(cart);
        }

        function removeFromCart(itemId){
            let cart = getCart();
            cart = cart.filter(i=>String(i.id)!==String(itemId));
            saveCart(cart);
            renderCartModal();
        }

        function clearCart(){
            try{ localStorage.removeItem('cafe_cart'); }catch(e){}
            renderCartModal();
            renderCartCount();
        }

        function renderCartModal(){
            const content = document.getElementById('cartContent');
            const totalEl = document.getElementById('cartTotal');
            if(!content || !totalEl) return;
            const cart = getCart();
            content.innerHTML = '';
            if(cart.length === 0){
                content.innerHTML = '<div style="color:#666;padding:10px;background:#fff;border-radius:6px;">Votre panier est vide.</div>';
                totalEl.textContent = '0.00';
                return;
            }
            let total = 0;
            cart.forEach(it=>{
                const row = document.createElement('div');
                row.style.display = 'flex';
                row.style.gap = '10px';
                row.style.alignItems = 'center';
                row.style.borderBottom = '1px solid #eee';
                row.style.paddingBottom = '8px';

                const title = document.createElement('div');
                title.style.flex = '1';
                let titleHtml = '<strong style="color:#8B4513">'+(it.name||'')+'</strong><div style="color:#666;font-size:0.9em">'+(it.quantity||0)+' x '+(Number(it.price||0).toFixed(2))+' DT</div>';
                if(it.note) titleHtml += '<div style="color:#999;font-size:0.85em;font-style:italic;margin-top:2px;">Note: '+it.note+'</div>';
                title.innerHTML = titleHtml;

                const price = document.createElement('div');
                const lineTotal = (Number(it.price||0) * Number(it.quantity||0));
                total += lineTotal;
                price.textContent = lineTotal.toFixed(2) + ' DT';
                price.style.fontWeight = '700';
                price.style.minWidth = '80px';

                const rm = document.createElement('button');
                rm.textContent = 'Supprimer';
                rm.style.background = 'transparent';
                rm.style.border = '1px solid #ccc';
                rm.style.padding = '6px 8px';
                rm.style.borderRadius = '6px';
                rm.style.cursor = 'pointer';
                rm.addEventListener('click', ()=> removeFromCart(it.id));

                row.appendChild(title);
                row.appendChild(price);
                row.appendChild(rm);
                content.appendChild(row);
            });
            totalEl.textContent = total.toFixed(2);
        }

        function openCartModal(){
            const m = document.getElementById('cartModal');
            if(!m) return;
            renderCartModal();
            m.style.display = 'flex';
        }

        function closeCartModal(){
            const m = document.getElementById('cartModal');
            if(!m) return;
            m.style.display = 'none';
        }

        // Attach events after DOM ready
        document.addEventListener('DOMContentLoaded', function(){
            // Ensure cartCount reflects stored cart
            renderCartCount();

            // Delegate clicks on order buttons inside menu grid
            const grid = document.getElementById('menu-grid');
            if(grid){
                grid.addEventListener('click', function(e){
                    const btn = e.target.closest && e.target.closest('.order-btn');
                    if(!btn) return;
                    const itemEl = btn.closest && btn.closest('.menu-item');
                    if(!itemEl) return;
                    const id = itemEl.getAttribute('data-id');
                    const qtyInput = itemEl.querySelector('.qty-input');
                    const qty = qtyInput ? Math.max(1, Number(qtyInput.value||1)) : 1;
                    
                    // Ask for optional note
                    showNotification('info', 'Ajouter une note (optionnel) ?', {
                        actions: [
                            { label: 'Ajouter note', callback: ()=>{
                                const note = prompt('Ajoutez une note pour cet article (ex: sans sucre, bien chaud...):', '');
                                addToCart(id, qty, note);
                                btn.textContent = 'Ajouté ✓';
                                setTimeout(()=> btn.textContent = 'Commander', 1200);
                            }},
                            { label: 'Sans note', callback: ()=>{
                                addToCart(id, qty, '');
                                btn.textContent = 'Ajouté ✓';
                                setTimeout(()=> btn.textContent = 'Commander', 1200);
                            }}
                        ]
                    });
                });
            }

            const cartBtn = document.getElementById('cartButton');
            if(cartBtn) cartBtn.addEventListener('click', openCartModal);
            const closeBtn = document.getElementById('closeCartBtn');
            if(closeBtn) closeBtn.addEventListener('click', closeCartModal);
            const clearBtn = document.getElementById('clearCartBtn');
            if(clearBtn) clearBtn.addEventListener('click', ()=>{
                showNotification('warning', 'Voulez-vous vraiment vider le panier ?', {
                    actions: [
                        { label: 'Oui', callback: ()=> clearCart() },
                        { label: 'Non', callback: ()=>{} }
                    ]
                });
            });
            const checkoutBtn = document.getElementById('checkoutBtn');
            if(checkoutBtn) checkoutBtn.addEventListener('click', async function(){
                const cart = getCart();
                if(!cart || cart.length===0) return showNotification('warning', 'Votre panier est vide');
                try{
                    const resp = await fetch('{{ path('api_orders') }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ items: cart })
                    });
                    const data = await resp.json();
                    if(!resp.ok) throw new Error(data.error || 'Erreur serveur');
                    clearCart();
                    closeCartModal();
                    showNotification('success', 'Commande envoyée au préparateur.');
                }catch(e){
                    console.error(e);
                    showNotification('error', 'Erreur lors de l\'envoi de la commande au serveur.');
                }
            });
        });
    </script>
{% endblock %}
