{% extends "admin/_layout_admin.html.twig" %}

{% block page_title %}Gestion des Commandes{% endblock %}

{% block admin_content %}
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2>📦 Commandes</h2>
            <div style="display: flex; gap: 10px;">
                <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">← Retour au Dashboard</a>
                <button type="button" class="btn btn-secondary" onclick="window.location.reload()">🔄 Actualiser</button>
            </div>
        </div>

        <div id="orders-container" class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Articles</th>
                        <th>Total</th>
                        <th>Statut</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% if orders|length == 0 %}
                    <tr>
                        <td colspan="6" style="text-align: center; color: #666;">Aucune commande</td>
                    </tr>
                    {% else %}
                        {% for order in orders %}
                        <tr>
                            <td>#{{ order.id }}</td>
                            <td>{{ order.customer|default('Invité') }}</td>
                            <td>
                                {% set itemsCount = 0 %}
                                {% for item in order.items %}
                                    {% set itemsCount = itemsCount + item.quantity %}
                                {% endfor %}
                                {{ itemsCount }} article(s)
                                <div style="font-size: 0.85em; color: #666; margin-top: 4px;">
                                    {% for item in order.items %}
                                        {{ item.name }} x{{ item.quantity }}{% if item.note is defined and item.note %} <em style="color: #999;">({{ item.note }})</em>{% endif %}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </div>
                            </td>
                            <td style="font-weight: bold;">
                                {% set total = 0 %}
                                {% for item in order.items %}
                                    {% set total = total + (item.price * item.quantity) %}
                                {% endfor %}
                                {{ total|number_format(2, '.', '') }} DT
                            </td>
                            <td>
                                {% if order.status == 'new' %}
                                    <span class="badge badge-warning">🆕 Nouvelle</span>
                                {% elseif order.status == 'preparing' %}
                                    <span class="badge badge-info">👨‍🍳 En Préparation</span>
                                {% elseif order.status == 'ready' %}
                                    <span class="badge badge-success">✅ Prêt</span>
                                {% elseif order.status == 'delivered' %}
                                    <span class="badge" style="background: #666;">📦 Livré</span>
                                {% else %}
                                    <span class="badge">{{ order.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if order.createdAt %}
                                    {{ order.createdAt|date('d/m/Y H:i') }}
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
