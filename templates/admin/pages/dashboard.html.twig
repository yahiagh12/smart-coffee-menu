{% extends "admin/_layout_admin.html.twig" %}

{% block page_title %}Tableau de Bord{% endblock %}

{% block admin_content %}
    <div class="stats-grid">
        <div class="stat-card success">
            <div class="stat-card-label">👥 Utilisateurs</div>
            <div class="stat-card-value">{{ userCount }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-card-label">🍰 Produits</div>
            <div class="stat-card-value">{{ productCount }}</div>
        </div>
        <div class="stat-card warning">
            <div class="stat-card-label">🛒 Commandes</div>
            <div class="stat-card-value">{{ orderCount }}</div>
        </div>
        <div class="stat-card danger">
            <div class="stat-card-label">💰 Revenus</div>
            <div class="stat-card-value">{{ totalRevenue|number_format(2, ',', ' ') }} DT</div>
        </div>
    </div>

    <div class="card">
        <h2>📈 Commandes Récentes</h2>
        {% if recentOrders|length > 0 %}
        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>Articles</th>
                        <th>Total</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in recentOrders %}
                    {% set total = 0 %}
                    {% for item in order.items %}
                        {% set total = total + (item.price * item.quantity) %}
                    {% endfor %}
                    <tr>
                        <td>#{{ order.id }}</td>
                        <td>{{ order.customer|default('Invité') }}</td>
                        <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                        <td>{{ order.items|length }} article(s)</td>
                        <td>{{ total|number_format(2, ',', ' ') }} DT</td>
                        <td>
                            {% if order.status == 'new' %}
                                <span class="badge badge-info">Nouvelle</span>
                            {% elseif order.status == 'preparing' %}
                                <span class="badge badge-warning">En préparation</span>
                            {% elseif order.status == 'ready' %}
                                <span class="badge badge-success">Prête</span>
                            {% elseif order.status == 'delivered' %}
                                <span class="badge badge-success">Livrée</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p style="color: #666; padding: 20px; text-align: center;">Aucune commande pour le moment</p>
        {% endif %}
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        <div class="card">
            <h2>🔧 Actions Rapides</h2>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <a href="{{ path('admin_users_list') }}" class="btn btn-primary">Gérer Utilisateurs</a>
                <a href="{{ path('admin_menu_list') }}" class="btn btn-primary">Gérer Menu</a>
                <a href="{{ path('admin_orders_list') }}" class="btn btn-primary">Voir Commandes</a>
                <a href="{{ path('admin_loyalty') }}" class="btn btn-primary">Configurer Points Fidélité</a>
            </div>
        </div>

        <div class="card">
            <h2>🛒 Commandes</h2>
            <p style="margin-bottom: 10px;">Consulter toutes les commandes</p>
            <a href="{{ path('admin_orders_list') }}" class="btn btn-warning" style="background: #f39c12;">Voir Commandes</a>
        </div>
    </div>
{% endblock %}
