{% extends 'admin/_layout_admin.html.twig' %}

{% block page_title %}Modifier événement{% endblock %}

{% block admin_content %}
<div class="card">
    <h2>Modifier un événement</h2>
    <form id="event-form" method="post" action="{{ path('admin_events_update_action', { id: id }) }}" enctype="multipart/form-data">
        <div class="form-group">
            <label>Nom</label>
            <input type="text" name="title" id="title" value="{{ event.title }}" required />
        </div>
        <div class="form-group">
            <label>Date</label>
            <input type="date" name="date" id="date" value="{{ event.date ? event.date|date('Y-m-d') : '' }}" required />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea name="description" id="description" rows="4" style="width:100%">{{ event.description }}</textarea>
        </div>
        <div class="form-group">
            <label>Statut</label>
            <select name="status" id="status" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;">
                <option value="draft" {{ event.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
                <option value="published" {{ event.status == 'published' ? 'selected' : '' }}>Publié</option>
                <option value="archived" {{ event.status == 'archived' ? 'selected' : '' }}>Archivé</option>
            </select>
        </div>
        <div class="form-group">
            <label>Visibilité</label>
            <select name="visibility" id="visibility" style="width:100%; padding:8px; border:1px solid #ddd; border-radius:4px;">
                <option value="public" {{ event.visibility == 'public' ? 'selected' : '' }}>Public (cafe_virtuel)</option>
                <option value="private" {{ event.visibility == 'private' ? 'selected' : '' }}>Privé (client only)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Image</label>
            <input type="file" id="event-image" name="image" accept="image/*" />
            {% if event.image %}
                <div style="margin-top:8px;"><img src="{{ event.image }}" style="max-width:240px; max-height:160px; object-fit:cover; border:1px solid #ddd; border-radius:4px;" /></div>
            {% endif %}
        </div>
        <p><button class="btn btn-primary" type="submit">Enregistrer</button> <a class="btn btn-secondary" href="{{ path('admin_events_data') }}">Annuler</a></p>
    </form>
</div>

{% endblock %}
