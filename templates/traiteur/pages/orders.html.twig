{% extends 'traiteur/_layout_traiteur.html.twig' %}
{% block title %}Gérer les commandes{% endblock %}
{% block heading %}Gérer les commandes{% endblock %}
{% block content %}

{% for message in app.flashes('warning') %}
    <div style="background:#ff9800; color:#fff; padding:12px; margin-bottom:16px; border-radius:4px;">
        {{ message }}
    </div>
{% endfor %}

<div class="card">
    <h3>Toutes les Commandes</h3>
    <table id="orders-table">
        <thead><tr><th>ID</th><th>Client</th><th>Articles</th><th>Total</th><th>Date</th><th>Statut</th><th>Action</th></tr></thead>
        <tbody>
            {% if orders|length > 0 %}
                {% for order in orders %}
                <tr>
                    <td>#{{ order.id }}</td>
                    <td>{{ order.customer|default('Invité') }}</td>
                    <td>
                        {% for item in order.items %}
                            {{ item.name }} x{{ item.quantity }}{% if item.note is defined and item.note %} <em style="color:#999;">({{ item.note }})</em>{% endif %}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                        {% if order.cancelReason is defined %}
                            <br><em style="color:#f44336; font-size:12px;">{{ order.cancelReason }}</em>
                        {% endif %}
                    </td>
                    <td style="font-weight: bold;">
                        {% set total = 0 %}
                        {% for item in order.items %}
                            {% set total = total + (item.price * item.quantity) %}
                        {% endfor %}
                        {{ total|number_format(2, '.', '') }} DT
                    </td>
                    <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        {% if order.status == 'new' %}
                            <span style="background:#ffc107; color:#fff; padding:4px 8px; border-radius:4px;">⏳ En attente</span>
                        {% elseif order.status == 'in_progress' %}
                            <span style="background:#2196f3; color:#fff; padding:4px 8px; border-radius:4px;">👨‍🍳 En cours</span>
                        {% elseif order.status == 'preparing' %}
                            <span style="background:#2196f3; color:#fff; padding:4px 8px; border-radius:4px;">👨‍🍳 En préparation</span>
                        {% elseif order.status == 'ready' %}
                            <span style="background:#4caf50; color:#fff; padding:4px 8px; border-radius:4px;">✅ Prêt</span>
                        {% elseif order.status == 'delivered' %}
                            <span style="background:#757575; color:#fff; padding:4px 8px; border-radius:4px;">📦 Livré</span>
                        {% elseif order.status == 'cancelled' %}
                            <span style="background:#f44336; color:#fff; padding:4px 8px; border-radius:4px;">❌ Annulée</span>
                        {% else %}
                            <span style="background:#ddd; padding:4px 8px; border-radius:4px;">{{ order.status }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if order.status != 'cancelled' %}
                        <form method="POST" action="{{ path('traiteur_update_order_status') }}" style="display:inline;">
                            <input type="hidden" name="order_id" value="{{ order.id }}">
                            <select name="status" onchange="this.form.submit()" style="padding: 6px 10px; border-radius: 5px; cursor: pointer; border: 1px solid #ddd;">
                                <option value="">-- Changer --</option>
                                <option value="new" {% if order.status == 'new' %}selected{% endif %}>⏳ En attente</option>
                                <option value="in_progress" {% if order.status == 'in_progress' %}selected{% endif %}>👨‍🍳 En cours</option>
                                <option value="preparing" {% if order.status == 'preparing' %}selected{% endif %}>👨‍🍳 En préparation</option>
                                <option value="ready" {% if order.status == 'ready' %}selected{% endif %}>✅ Prêt</option>
                                <option value="delivered" {% if order.status == 'delivered' %}selected{% endif %}>📦 Livré</option>
                            </select>
                        </form>
                        {% else %}
                            <span style="color:#999;">-</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            {% else %}
                <tr><td colspan="7" style="text-align:center; color:#999; padding:20px;">Aucune commande pour le moment</td></tr>
            {% endif %}
        </tbody>
    </table>
    <p style="margin-top:12px"><a class="btn" href="{{ path('traiteur_dashboard') }}">Retour</a></p>
</div>

{% endblock %}
