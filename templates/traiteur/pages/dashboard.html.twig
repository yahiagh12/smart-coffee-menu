{% extends 'traiteur/_layout_traiteur.html.twig' %}

{% block heading %}Tableau de bord Traiteur{% endblock %}

{% block content %}
<div class="grid">
    <div class="card">
        <h3>📦 Commandes en attente</h3>
        <p style="font-size: 2em; font-weight: bold; color: #2563eb;">{{ pendingOrders|length }}</p>
    </div>
    <div class="card">
        <h3>🍰 Produits disponibles</h3>
        <p style="font-size: 2em; font-weight: bold; color: #10b981;">{{ productCount }}</p>
    </div>
    <div class="card">
        <h3>💰 Revenus du jour</h3>
        <p style="font-size: 2em; font-weight: bold; color: #f59e0b;">{{ todayRevenue|number_format(2, ',', ' ') }} DT</p>
    </div>
</div>

{% if pendingOrders|length > 0 %}
<div class="card" style="margin-top: 20px; background: #fff3cd; border-left: 4px solid #ffc107;">
    <h2>🔔 Nouvelles commandes en attente</h2>
    <div style="margin-top: 16px;">
        {% for order in pendingOrders %}
        <div style="background: white; padding: 12px; margin-bottom: 10px; border-radius: 6px; border: 1px solid #ddd;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <strong style="color: #2563eb;">#{{ order.id }}</strong> - 
                    <span>{{ order.customer|default('Invité') }}</span>
                    <div style="color: #666; font-size: 0.9em; margin-top: 4px;">
                        {% set total = 0 %}
                        {% for item in order.items %}
                            {{ item.name }} x{{ item.quantity }}{% if item.note is defined and item.note %} <em style="color: #999;">({{ item.note }})</em>{% endif %}{% if not loop.last %}, {% endif %}
                            {% set total = total + (item.price * item.quantity) %}
                        {% endfor %}
                    </div>
                    <div style="font-weight: bold; margin-top: 4px;">Total: {{ total|number_format(2, ',', ' ') }} DT</div>
                </div>
                <div>
                    <form method="post" action="{{ path('traiteur_update_order_status') }}" style="display: inline;">
                        <input type="hidden" name="order_id" value="{{ order.id }}">
                        <input type="hidden" name="status" value="preparing">
                        <button type="submit" class="btn" style="background: #2196f3; color: white;">👨‍🍳 Prendre en charge</button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% else %}
<div class="card" style="margin-top: 20px;">
    <p style="text-align: center; color: #666;">Aucune nouvelle commande en attente</p>
</div>
{% endif %}

<div class="card" style="margin-top: 20px;">
    <h2>📋 Actions rapides</h2>
    <div style="display: flex; gap: 12px; margin-top: 16px;">
        <a href="{{ path('traiteur_orders_list') }}" class="btn" style="background:#2563eb;">Voir toutes les commandes</a>
        <a href="{{ path('traiteur_products') }}" class="btn" style="background:#10b981;">Gérer les produits</a>
        <button onclick="window.location.reload()" class="btn" style="background:#6b7280;">🔄 Actualiser</button>
    </div>
</div>
{% endblock %}

