{% extends "base.html.twig" %}

{% block title %}Café Virtuel - Votre Espace de Détente{% endblock %}

{% block stylesheets %}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            color: #333;
            min-height: 100vh;
        }

        /* Header */
        .header {
            background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.95;
        }

        /* Navigation */
        .nav {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .nav button {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            border: 2px solid white;
            padding: 10px 20px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .nav button:hover {
            background: white;
            color: #8B4513;
            transform: translateY(-2px);
        }

        /* Main Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Sections */
        .section {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section h2 {
            color: #8B4513;
            margin-bottom: 20px;
            font-size: 2em;
            border-bottom: 3px solid #D2691E;
            padding-bottom: 10px;
        }

        /* Menu Grid */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .menu-item {
            background: linear-gradient(135deg, #fff5f1 0%, #ffe4d6 100%);
            border-left: 5px solid #8B4513;
            padding: 20px;
            border-radius: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .menu-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            background: linear-gradient(135deg, #fff0e6 0%, #ffd9c2 100%);
        }

        .menu-item h3 {
            color: #8B4513;
            margin-bottom: 10px;
            font-size: 1.3em;
        }

        .menu-item .description {
            color: #666;
            font-size: 0.9em;
            margin-bottom: 10px;
        }

        .menu-item .price {
            color: #D2691E;
            font-weight: bold;
            font-size: 1.2em;
        }

        .menu-item .temperature {
            color: #999;
            font-size: 0.85em;
            margin-top: 8px;
            font-style: italic;
        }

        /* Features Section */
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .feature-card {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .feature-card .icon {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .feature-card h3 {
            color: #2e7d32;
            margin-bottom: 10px;
        }

        .feature-card p {
            color: #555;
            font-size: 0.9em;
        }

        /* Chat Section */
        .chat-container {
            background: linear-gradient(135deg, #f5f5f5 0%, #efefef 100%);
            border-radius: 10px;
            padding: 20px;
            height: 400px;
            display: flex;
            flex-direction: column;
            margin-top: 20px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 15px;
            padding: 10px;
            background: white;
            border-radius: 8px;
        }

        .message {
            margin-bottom: 10px;
            padding: 10px 15px;
            border-radius: 8px;
            max-width: 80%;
            word-wrap: break-word;
        }

        .message.user {
            background: #8B4513;
            color: white;
            margin-left: auto;
        }

        .message.bot {
            background: #e0e0e0;
            color: #333;
            margin-right: auto;
        }

        .chat-input {
            display: flex;
            gap: 10px;
        }

        .chat-input input {
            flex: 1;
            padding: 10px;
            border: 2px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
        }

        .chat-input button {
            background: #8B4513;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .chat-input button:hover {
            background: #A0522D;
        }

        /* About Section */
        .about-content {
            line-height: 1.8;
            color: #555;
        }

        .about-content p {
            margin-bottom: 15px;
        }

        /* Footer */
        .footer {
            background: #1a1a2e;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
            box-shadow: 0 -4px 6px rgba(0, 0, 0, 0.3);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header h1 {
                font-size: 2em;
            }

            .menu-grid {
                grid-template-columns: 1fr;
            }

            .nav {
                flex-direction: column;
            }

            .nav button {
                width: 100%;
            }

            .chat-container {
                height: 300px;
            }
        }

        /* Animations */
        .coffee-animation {
            display: inline-block;
            animation: steam 2s infinite;
        }

        @keyframes steam {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }

        /* Category filter styles */
        .category-filter-wrapper {
            display: flex;
            gap: 12px;
            align-items: center;
            margin-top: 18px;
        }

        .category-filter-control {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(180deg,#fff 0,#fff5f1 100%);
            border: 1px solid #e6dccf;
            padding: 6px 8px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .category-filter {
            border: none;
            background: transparent;
            font-size: 0.95em;
            padding: 6px 8px;
            appearance: none;
            -webkit-appearance: none;
            color: #333;
        }

        .category-filter:disabled { opacity: 0.6; }

        .category-clear-btn {
            background: transparent;
            border: none;
            color: #8B4513;
            font-weight: bold;
            cursor: pointer;
            padding: 4px 6px;
            border-radius: 6px;
        }

        .category-clear-btn:hover { background: rgba(139,69,19,0.06); }

        .loader-spinner {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid rgba(0,0,0,0.08);
            border-top-color: #8B4513;
            animation: spin 0.9s linear infinite;
            display: none;
        }

        .loader-spinner.visible { display: inline-block; }

        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
{% endblock %}

{% block body %}
    <!-- Header -->
    <div class="header">
        <h1>☕ Café Virtuel</h1>
        <p>Votre espace de détente et de convivialité en ligne</p>
        <div class="nav">
            <button type="button" onclick="showSection('accueil')">Accueil</button>
            <button type="button" onclick="showSection('menu')">Menu</button>
            <button type="button" onclick="window.location.href='/view?t=client/account.html.twig'">Profile</button>
            <button type="button" onclick="showSection('chat')">Chat</button>
            <button type="button" onclick="showSection('about')">À Propos</button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <!-- Accueil Section -->
        <div class="section active" id="accueil">
            <h2>Bienvenue dans notre Café Virtuel</h2>
            <p style="font-size: 1.1em; color: #555; margin-bottom: 30px;">
                Rejoignez-nous pour un moment de détente, de conversation et de camaraderie. 
                Notre café virtuel est ouvert 24h/24 pour vous accueillir!
            </p>

            <div class="features">
                <div class="feature-card">
                    <div class="icon">🌍</div>
                    <h3>Accessible</h3>
                    <p>Accessible depuis n'importe où, n'importe quand</p>
                </div>
                <div class="feature-card">
                    <div class="icon">👥</div>
                    <h3>Communauté</h3>
                    <p>Rencontrez des personnes du monde entier</p>
                </div>
                <div class="feature-card">
                    <div class="icon">☕</div>
                    <h3>Qualité</h3>
                    <p>Les meilleures boissons virtuelles</p>
                </div>
                <div class="feature-card">
                    <div class="icon">💬</div>
                    <h3>Convivialité</h3>
                    <p>Discutez et partagez vos moments</p>
                </div>
            </div>
        </div>

        <!-- Menu Section (API-driven) -->
        <div class="section" id="menu">
            <h2>Notre Menu</h2>

            <div class="category-filter-wrapper">
                <label for="category-filter" style="color:#555; font-weight:600;">Filtrer par catégorie:</label>
                <div class="category-filter-control">
                    <select id="category-filter" class="category-filter" aria-label="Filtrer par catégorie" disabled>
                        <option value="">Toutes</option>
                    </select>
                    <button id="clear-filter" class="category-clear-btn" title="Réinitialiser le filtre">✕</button>
                    <div id="cat-loader" class="loader-spinner" aria-hidden="true"></div>
                </div>
            </div>

            <div id="menu-grid" class="menu-grid" style="margin-top:20px;">
                <!-- menu items will be rendered here -->
            </div>
        </div>

        <!-- Chat Section -->
        <div class="section" id="chat">
            <h2>Rejoignez le Chat</h2>
            <p style="color: #555; margin-bottom: 15px;">
                Discutez avec d'autres clients du café virtuel, partagez vos expériences et faites connaissance!
            </p>
            <div class="chat-container">
                <div class="chat-messages" id="chatMessages">
                    <div class="message bot">Bienvenue au Café Virtuel! 👋</div>
                    <div class="message bot">Comment puis-je vous aider aujourd'hui?</div>
                </div>
                <div class="chat-input">
                    <input type="text" id="chatInput" placeholder="Tapez votre message...">
                    <button type="button" onclick="sendMessage()">Envoyer</button>
                </div>
            </div>
        </div>

        <!-- About Section -->
        <div class="section" id="about">
            <h2>À Propos de Nous</h2>
            <div class="about-content">
                <p>
                    <strong>Le Café Virtuel</strong> est un projet communautaire créé pour offrir un espace 
                    de détente et de convivialité en ligne.
                </p>
                <p>
                    Notre mission est de créer un lieu où les gens peuvent se rencontrer, discuter, 
                    partager leurs passions pour le café et simplement profiter d'un moment de détente 
                    en ligne.
                </p>
                <h3 style="color: #8B4513; margin-top: 20px; margin-bottom: 10px;">Nos Valeurs</h3>
                <ul style="margin-left: 20px; color: #555;">
                    <li>🤝 Communauté et entraide</li>
                    <li>☕ Passion pour le café</li>
                    <li>🌍 Inclusivité et diversité</li>
                    <li>💡 Innovation et créativité</li>
                    <li>😊 Bien-être et détente</li>
                </ul>
                <h3 style="color: #8B4513; margin-top: 20px; margin-bottom: 10px;">Horaires</h3>
                <p>Ouvert 24h/24, 7 jours sur 7</p>
                <h3 style="color: #8B4513; margin-top: 20px; margin-bottom: 10px;">Contact</h3>
                <p>Email: info@cafevirtuel.com<br>
                   Téléphone: +33 1 23 45 67 89</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>&copy; 2025 Café Virtuel. Tous droits réservés. ☕</p>
        <p>Créé avec ❤️ pour les amateurs de café</p>
    </div>

    <!-- Scripts -->
    <script>
        function showSection(sectionId) {
            // Masquer toutes les sections
            const sections = document.querySelectorAll('.section');
            sections.forEach(section => {
                section.classList.remove('active');
            });

            // Afficher la section sélectionnée
            const activeSection = document.getElementById(sectionId);
            if (activeSection) {
                activeSection.classList.add('active');
                // Scroll to top
                window.scrollTo(0, 0);
            }
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();

            if (message === '') return;

            const chatMessages = document.getElementById('chatMessages');

            // Ajouter le message de l'utilisateur
            const userMsg = document.createElement('div');
            userMsg.className = 'message user';
            userMsg.textContent = message;
            chatMessages.appendChild(userMsg);

            input.value = '';

            // Scroll to bottom
            chatMessages.scrollTop = chatMessages.scrollHeight;

            // Simuler une réponse du bot
            setTimeout(() => {
                const botMsg = document.createElement('div');
                botMsg.className = 'message bot';
                const responses = [
                    'C\'est une excellente question! ☕',
                    'Je suis d\'accord avec vous!',
                    'Vous avez raison, le café est délicieux! 😊',
                    'Merci pour votre participation!',
                    'C\'est vrai, notre café est le meilleur! ☕',
                    'Bonne idée! Avez-vous d\'autres suggestions?'
                ];
                botMsg.textContent = responses[Math.floor(Math.random() * responses.length)];
                chatMessages.appendChild(botMsg);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }, 500);
        }

        // Permettre d'envoyer le message avec la touche Entrée
        document.addEventListener('DOMContentLoaded', function() {
            const chatInput = document.getElementById('chatInput');
            if (chatInput) {
                chatInput.addEventListener('keypress', function(event) {
                    if (event.key === 'Enter') {
                        sendMessage();
                    }
                });
            }
            // initial render of API-driven menu
            initMenuFromApi();
        });

        // --- Menu API integration ---
        async function fetchJson(url, opts = {}){
            try{
                const res = await fetch(url, opts);
                if(!res.ok) throw new Error('HTTP ' + res.status);
                return await res.json();
            }catch(e){ console.error('fetchJson', url, e); return []; }
        }

        function escapeHtml(s){ if(s === null || s === undefined) return ''; return String(s).replace(/[&<>"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]; }); }

        async function initMenuFromApi(){
            const apiBase = '/api';
            const [cats, items] = await Promise.all([
                fetchJson(apiBase + '/categories'),
                fetchJson(apiBase + '/menu-items')
            ]);

            const catSelect = document.getElementById('category-filter');
            const grid = document.getElementById('menu-grid');
            const loader = document.getElementById('cat-loader');
            const clearBtn = document.getElementById('clear-filter');
            const catMap = {};

            // show loading state
            catSelect.disabled = true;
            loader.classList.add('visible');

            // ensure arrays
            const categories = Array.isArray(cats) ? cats : [];
            const itemsArr = Array.isArray(items) ? items : [];

            // compute counts per category
            const counts = {};
            itemsArr.forEach(it => { const k = it.categorie ? String(it.categorie) : ''; counts[k] = (counts[k] || 0) + 1; });

            // populate select: first option = all
            catSelect.innerHTML = '';
            const total = itemsArr.length || 0;
            const allOption = document.createElement('option');
            allOption.value = '';
            allOption.textContent = `Toutes (${total})`;
            catSelect.appendChild(allOption);

            categories.forEach(c => {
                catMap[String(c.id)] = c.name;
                const opt = document.createElement('option');
                opt.value = c.id;
                const count = counts[String(c.id)] || 0;
                opt.textContent = `${c.name} (${count})`;
                if (count === 0) opt.style.opacity = '0.6';
                catSelect.appendChild(opt);
            });

            // hide loader and enable
            loader.classList.remove('visible');
            catSelect.disabled = false;

            // clear button
            clearBtn.addEventListener('click', function(e){ e.preventDefault(); catSelect.value = ''; render(itemsArr); });

            function formatPrice(p){ if(p === null || p === undefined) return ''; return '€' + parseFloat(p).toFixed(2); }

            function render(itemsToRender){
                grid.innerHTML = '';
                if(!itemsToRender || itemsToRender.length === 0){ grid.innerHTML = '<div style="padding:20px; color:#666">Aucun produit trouvé</div>'; return; }
                itemsToRender.forEach(it => {
                    const div = document.createElement('div');
                    div.className = 'menu-item';
                    const catName = it.categorie ? (catMap[String(it.categorie)] ?? it.categorie) : '';
                    const img = it.image ? `<div style="margin-bottom:10px;"><img src="${it.image}" alt="" style="width:100%;height:140px;object-fit:cover;border-radius:8px;"></div>` : '';
                    div.innerHTML = `
                        ${img}
                        <h3>${escapeHtml(it.name)}</h3>
                        <p class="description">${escapeHtml(it.description ?? '')}</p>
                        <p class="price">${formatPrice(it.price)}</p>
                        ${catName ? `<p style="color:#999; font-size:0.9em">${escapeHtml(catName)}</p>` : ''}
                    `;
                    grid.appendChild(div);
                });
            }

            // initial render
            render(items || []);

            catSelect.addEventListener('change', function(){
                const v = this.value;
                if(!v) return render(items || []);
                render((items || []).filter(it => String(it.categorie) === String(v)));
            });
        }
    </script>
{% endblock %}
