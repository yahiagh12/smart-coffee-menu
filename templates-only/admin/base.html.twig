{% extends "base_notification.html.twig" %}

{% block title %}Admin - {{ block('page_title') }}{% endblock %}

{% block stylesheets %}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            color: #333;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .admin-sidebar {
            width: 260px;
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
            padding: 20px 0;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
        }

        .admin-sidebar h2 {
            padding: 20px 20px 10px;
            font-size: 1.5em;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }

        .admin-sidebar a {
            display: block;
            padding: 12px 20px;
            color: #ecf0f1;
            text-decoration: none;
            transition: all 0.3s;
            border-left: 4px solid transparent;
        }

        .admin-sidebar a:hover {
            background: rgba(255, 255, 255, 0.1);
            border-left-color: #3498db;
            padding-left: 25px;
        }

        .admin-sidebar a.active {
            background: rgba(52, 152, 219, 0.2);
            border-left-color: #3498db;
            color: #3498db;
        }

        .menu-section {
            margin-top: 20px;
        }

        .menu-section-title {
            padding: 10px 20px;
            font-size: 0.85em;
            color: #95a5a6;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
        }

        /* Main Content */
        .admin-main {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .admin-header {
            background: white;
            padding: 20px 30px;
            border-bottom: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .admin-header h1 {
            font-size: 1.8em;
            color: #2c3e50;
        }

        .admin-header-right {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .admin-header-right a {
            color: #3498db;
            text-decoration: none;
            padding: 8px 15px;
            border-radius: 5px;
            transition: background 0.3s;
        }

        .admin-header-right a:hover {
            background: #ecf0f1;
        }

        .admin-content {
            flex: 1;
            padding: 30px;
        }

        /* Cards */
        .card {
            background: white;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        .card h2 {
            color: #2c3e50;
            margin-bottom: 20px;
            font-size: 1.5em;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            border-left: 5px solid #3498db;
        }

        .stat-card.success {
            border-left-color: #27ae60;
        }

        .stat-card.warning {
            border-left-color: #f39c12;
        }

        .stat-card.danger {
            border-left-color: #e74c3c;
        }

        .stat-card-label {
            color: #95a5a6;
            font-size: 0.9em;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .stat-card-value {
            font-size: 2.5em;
            font-weight: bold;
            color: #2c3e50;
        }

        /* Tables */
        .table-responsive {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table thead {
            background: #f8f9fa;
        }

        table th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: #2c3e50;
            border-bottom: 2px solid #dee2e6;
        }

        table td {
            padding: 12px;
            border-bottom: 1px solid #dee2e6;
        }

        table tbody tr:hover {
            background: #f8f9fa;
        }

        /* Buttons */
        .btn {
            display: inline-block;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
            text-decoration: none;
            transition: all 0.3s;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-primary:hover {
            background: #2980b9;
            transform: translateY(-2px);
        }

        .btn-success {
            background: #27ae60;
            color: white;
        }

        .btn-success:hover {
            background: #229954;
        }

        .btn-danger {
            background: #e74c3c;
            color: white;
        }

        .btn-danger:hover {
            background: #c0392b;
        }

        .btn-secondary {
            background: #95a5a6;
            color: white;
        }

        .btn-secondary:hover {
            background: #7f8c8d;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 0.9em;
        }

        /* Forms */
        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #2c3e50;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
            font-family: inherit;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus,
        input[type="number"]:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 5px rgba(52, 152, 219, 0.3);
        }

        /* Badges */
        .badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
        }

        .badge-success {
            background: #d4edda;
            color: #155724;
        }

        .badge-warning {
            background: #fff3cd;
            color: #856404;
        }

        .badge-danger {
            background: #f8d7da;
            color: #721c24;
        }

        .badge-info {
            background: #d1ecf1;
            color: #0c5460;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .admin-sidebar {
                width: 70px;
                padding: 10px 0;
            }

            .admin-sidebar h2 {
                font-size: 1em;
                padding: 10px;
                text-align: center;
            }

            .admin-sidebar a {
                padding: 12px;
                text-align: center;
                font-size: 0;
            }

            .admin-sidebar a::before {
                font-size: 1.2em;
            }

            .admin-main {
                margin-left: 70px;
            }

            .admin-header {
                flex-direction: column;
                gap: 10px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            table {
                font-size: 0.9em;
            }

            table th, table td {
                padding: 8px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="admin-container">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <h2>☕ Admin</h2>

            <a href="{{ path('admin_dashboard') }}" class="{% if 'dashboard' in app.request.attributes.get('_route', '') %}active{% endif %}">
                📊 Dashboard
            </a>

            <div class="menu-section">
                <div class="menu-section-title">Gestion</div>
                <a href="{{ path('admin_users_list') }}" class="{% if 'users' in app.request.attributes.get('_route', '') %}active{% endif %}">
                    👥 Utilisateurs
                </a>
                <a href="{{ path('admin_menu_list') }}" class="{% if 'menu' in app.request.attributes.get('_route', '') %}active{% endif %}">
                    🍰 Menu
                </a>
                <a href="{{ path('admin_events_list') }}" class="{% if 'events' in app.request.attributes.get('_route', '') %}active{% endif %}">
                    🎫 Événements
                </a>
                {# Removed separate manage pages; CRUD is inline on list pages #}
                <a href="/admin/suggestions/list" class="{% if 'suggestions' in app.request.attributes.get('_route', '') %}active{% endif %}">
                    💡 Suggestions
                </a>
                <a href="/admin/loyalty" class="{% if 'loyalty' in app.request.attributes.get('_route', '') %}active{% endif %}">
                    ⭐ Points Fidélité
                </a>
                {# Orders removed from admin menu per request #}
            </div>

            <div class="menu-section">
                <div class="menu-section-title">Autres</div>
                <a href="{{ path('admin_settings') }}">⚙️ Paramètres</a>
                <a href="{{ path('app_logout') }}" onclick="localStorage.clear();" style="color: #e74c3c;">🚪 Déconnexion</a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Header -->
            <header class="admin-header">
                <h1>{% block page_title %}Tableau de Bord{% endblock %}</h1>
                <div class="admin-header-right">
                    <span>👤 Admin</span>
                    <a href="/auth_login" onclick="localStorage.clear();" style="color: #e74c3c;">🚪 Déconnexion</a>
                </div>
            </header>

            <!-- Content -->
            <div class="admin-content">
                {% block admin_content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}
