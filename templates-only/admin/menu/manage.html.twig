{% extends 'admin/base.html.twig' %}
{% block page_title %}Gérer le menu{% endblock %}
{% block admin_content %}
<div class="card">
    <h2>Menu - Gérer les produits</h2>
    <p><button id="new-btn" class="btn btn-primary">Ajouter un produit</button></p>
    <div class="table-responsive">
        <table id="menu-table"><thead><tr><th>ID</th><th>Nom</th><th>Catégorie</th><th>Prix</th><th>Actions</th></tr></thead><tbody></tbody></table>
    </div>
</div>

<script>
function readMenu(){try{return JSON.parse(localStorage.getItem('preview_menu')||'null')||[]}catch(e){return[]}}
function saveMenu(m){localStorage.setItem('preview_menu',JSON.stringify(m))}
function render(){const tbody=document.querySelector('#menu-table tbody'); tbody.innerHTML=''; const items=readMenu(); items.forEach(it=>{const tr=document.createElement('tr'); tr.innerHTML=`<td>${it.id}</td><td>${it.name}</td><td>${it.category||''}</td><td>${it.price||''}</td><td><button class="btn" data-id="${it.id}" data-action="edit">Edit</button> <button class="btn btn-danger" data-id="${it.id}" data-action="del">Suppr</button></td>`; tbody.appendChild(tr);}); document.querySelectorAll('#menu-table button').forEach(b=>b.addEventListener('click',e=>{const id=parseInt(e.currentTarget.dataset.id,10); const action=e.currentTarget.dataset.action; if(action==='del'){showNotification('info', 'Confirmer la suppression du produit ?', {actions: [ { label: 'Supprimer', callback: () => { let list=readMenu(); list=list.filter(x=>x.id!==id); saveMenu(list); render(); showNotification('success', 'Produit supprimé'); }}, { label: 'Annuler', callback: () => {} } ]}); return;} if(action==='edit'){showNotification('info', 'Édition du produit non interactive (remplacer prompt par modal si besoin)'); const list=readMenu(); const item=list.find(x=>x.id===id); const name=prompt('Nom',item.name); if(name===null) return; const category=prompt('Catégorie',item.category||''); const price=prompt('Prix',item.price||''); item.name=name; item.category=category; item.price=price; saveMenu(list); render(); return;} }));}
document.getElementById('new-btn').addEventListener('click',function(){showNotification('info', 'Ajout du produit non interactif (remplacer prompt par modal si besoin)'); const name=prompt('Nom du produit'); if(!name) return; const category=prompt('Catégorie','Boissons'); const price=prompt('Prix','2.50'); const list=readMenu(); const id=list.length? Math.max(...list.map(x=>x.id))+1:1; list.push({id:id,name:name,category:category,price:price}); saveMenu(list); render();});
// init sample
if(!localStorage.getItem('preview_menu')){const s=[{id:1,name:'Café',category:'Boissons',price:'1.50'},{id:2,name:'Croissant',category:'Viennoiserie',price:'1.20'}]; saveMenu(s);} render();
</script>

{% endblock %}
