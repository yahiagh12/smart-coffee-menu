{% extends 'admin/base.html.twig' %}

{% block page_title %}Ajouter un produit{% endblock %}

{% block admin_content %}
    <h2>Ajouter un produit</h2>

    {{ form_start(form) }}
        <div class="form-group">{{ form_row(form.name) }}</div>
        <div class="form-group">{{ form_row(form.description) }}</div>
        <div class="form-group">{{ form_row(form.price) }}</div>
        <div class="form-group">{{ form_row(form.imageFile) }}</div>
        <div class="form-group">{{ form_row(form.category) }}</div>
        <div class="form-group">{{ form_row(form.stock) }}</div>
        <div class="form-group">{{ form_row(form.available) }}</div>
        <button class="btn btn-success">Créer</button>
    {{ form_end(form) }}

    <p><a href="{{ path('admin_menu_index') }}">← Retour à la liste</a></p>
{% endblock %}
