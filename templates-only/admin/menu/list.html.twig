{% extends "admin/base.html.twig" %}

{% block page_title %}Gestion du Menu{% endblock %}

{% block admin_content %}
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2>🍰 Liste des Produits</h2>
            <button id="add-product" class="btn btn-success">+ Ajouter Produit</button>
        </div>

        <div style="margin-bottom: 20px; display:flex; gap:10px; align-items:center;">
            <a href="{{ path('admin_menu_categories') }}" class="btn btn-secondary">📂 Gérer Catégories</a>
            <div style="color:#666; font-size:0.9em;">Les catégories sont synchronisées depuis la page de gestion des catégories.</div>
        </div>

        <div class="table-responsive">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Nom</th>
                        <th>Catégorie</th>
                        <th>Prix</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="menu-tbody">
                    <!-- JavaScript will populate this -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal for add/edit -->
    <div id="product-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); justify-content:center; align-items:center; z-index:1000;">
        <div style="background:white; padding:20px; border-radius:8px; width:90%; max-width:500px;">
            <h3 id="product-modal-title">Ajouter un produit</h3>
            <form id="product-form">
                <input type="hidden" id="product-id">
                <div style="margin-bottom:10px;">
                    <label>Nom:</label>
                    <input type="text" id="product-name" required style="width:100%; padding:8px; margin-top:5px;">
                </div>
                <div style="margin-bottom:10px;">
                    <label>Catégorie:</label>
                    <select id="product-category" style="width:100%; padding:8px; margin-top:5px;">
                        <option value="">Aucune catégorie</option>
                    </select>
                </div>
                <div style="margin-bottom:10px;">
                    <label>Prix:</label>
                    <input type="number" id="product-price" step="0.01" min="0" style="width:100%; padding:8px; margin-top:5px;">
                </div>
                <div style="margin-bottom:10px;">
                    <label>Description:</label>
                    <textarea id="product-description" style="width:100%; padding:8px; margin-top:5px; height:80px;"></textarea>
                </div>
                <div style="margin-bottom:10px;">
                    <label>Image:</label>
                    <input type="file" id="product-image" accept="image/*" style="width:100%; padding:8px; margin-top:5px;">
                </div>
                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button" id="product-cancel" class="btn btn-secondary">Annuler</button>
                    <button type="submit" class="btn btn-primary">Sauvegarder</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        (function(){
            const tbody = document.getElementById('menu-tbody');
            const apiBase = '/api';
            let categories = [];

            async function fetchCategories(){
                try{
                    const res = await fetch(apiBase + '/categories');
                    if(!res.ok) return [];
                    const data = await res.json();
                    return data.map(d => ({ 
                        id: d.id ?? d[0] ?? null, 
                        name: d.name ?? d[1] ?? String(d) 
                    }));
                }catch(e){ 
                    console.error('Error fetching categories:', e);
                    return []; 
                }
            }

            async function fetchMenu(){
                try{
                    const res = await fetch(apiBase + '/menu-items');
                    if(!res.ok) throw new Error('Failed to fetch menu');
                    return await res.json();
                }catch(e){
                    console.error('Error fetching menu:', e);
                    return [];
                }
            }

            function formatPrice(p){ 
                return p === null || p === undefined ? '' : '€' + parseFloat(p).toFixed(2); 
            }

            async function render(){
                tbody.innerHTML = '';
                const items = await fetchMenu();
                categories = await fetchCategories();
                const catMap = Object.fromEntries(categories.map(c => [String(c.id), c.name]));

                console.log('Fetched items:', items); // Debug log
                console.log('Fetched categories:', categories); // Debug log

                if (items.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px;">Aucun produit trouvé</td></tr>';
                    return;
                }

                items.forEach(it => {
                    const tr = document.createElement('tr');
                    const imgCell = it.image ? `<img src="${it.image}" alt="" style="width:48px;height:36px;object-fit:cover;border-radius:4px;">` : '';
                    const categoryName = it.categorie ? (catMap[String(it.categorie)] ?? it.categorie) : 'Aucune';
                    
                    tr.innerHTML = `
                        <td>${it.id}</td>
                        <td>${imgCell}</td>
                        <td>${it.name}</td>
                        <td>${categoryName}</td>
                        <td>${formatPrice(it.price)}</td>
                        <td>
                            <button class="btn btn-primary btn-sm" data-id="${it.id}" data-action="edit">Éditer</button> 
                            <button class="btn btn-danger btn-sm" data-id="${it.id}" data-action="del">Supprimer</button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });

                // Add event listeners to buttons
                tbody.querySelectorAll('button').forEach(b => {
                    b.addEventListener('click', (ev) => {
                        const id = parseInt(b.dataset.id, 10);
                        const action = b.dataset.action;
                        if(action === 'del'){
                            if(!confirm('Supprimer ce produit ?')) return;
                            deleteItem(id).then(render);
                            return;
                        }
                        if(action === 'edit') openProductModal('edit', id);
                    });
                });
            }

            async function openProductModal(mode, id){
                const modal = document.getElementById('product-modal');
                const title = document.getElementById('product-modal-title');
                const hid = document.getElementById('product-id');
                const name = document.getElementById('product-name');
                const category = document.getElementById('product-category');
                const price = document.getElementById('product-price');
                const descriptionEl = document.getElementById('product-description');

                categories = await fetchCategories();
                category.innerHTML = '<option value="">Aucune catégorie</option>';
                categories.forEach(c => { 
                    const o = document.createElement('option'); 
                    o.value = c.id; 
                    o.textContent = c.name; 
                    category.appendChild(o); 
                });

                if(mode === 'edit'){
                    title.textContent = 'Éditer le produit';
                    const res = await fetch(apiBase + '/menu-items/' + id);
                    if(!res.ok){ 
                        alert('Element introuvable'); 
                        return; 
                    }
                    const it = await res.json();
                    hid.value = it.id;
                    name.value = it.name || '';
                    price.value = it.price ?? '';
                    descriptionEl.value = it.description ?? '';
                    if(it.categorie) category.value = it.categorie;
                } else {
                    title.textContent = 'Ajouter un produit';
                    hid.value = '';
                    name.value = '';
                    price.value = '';
                    descriptionEl.value = '';
                    category.value = '';
                }

                modal.style.display = 'flex';
            }

            function closeProductModal(){ 
                document.getElementById('product-modal').style.display = 'none'; 
            }

            // create/update will be handled via FormData in the submit handler (to support image upload)

            async function deleteItem(id){
                const res = await fetch(apiBase + '/menu-items/' + id, { method: 'DELETE' });
                return res.ok;
            }

            // Event listeners
            document.getElementById('add-product').addEventListener('click', () => openProductModal('add'));
            document.getElementById('product-cancel').addEventListener('click', closeProductModal);

            document.getElementById('product-form').addEventListener('submit', async function(e){
                e.preventDefault();
                const hid = document.getElementById('product-id').value;
                const name = document.getElementById('product-name').value.trim();
                const category = document.getElementById('product-category').value || null;
                const price = parseFloat(document.getElementById('product-price').value) || 0;
                const description = document.getElementById('product-description').value;
                const imageFile = document.getElementById('product-image').files[0];

                if(!name){ 
                    alert('Le nom est requis'); 
                    return; 
                }
                if(price < 0){ 
                    alert('Le prix doit être >= 0'); 
                    return; 
                }

                // Build FormData so we can include an optional image
                const fd = new FormData();
                fd.append('name', name);
                fd.append('price', String(price));
                fd.append('description', description);
                if (category) fd.append('categorie', String(category));
                if (imageFile) fd.append('image', imageFile);

                try{
                    let res;
                    if(hid){
                        // send as POST to the item endpoint (controller accepts POST for updates)
                        res = await fetch(apiBase + '/menu-items/' + hid, { method: 'POST', body: fd });
                    } else {
                        res = await fetch(apiBase + '/menu-items', { method: 'POST', body: fd });
                    }
                    if(!res.ok) throw new Error('Server error: ' + res.status);
                    closeProductModal();
                    await render();
                }catch(err){
                    console.error(err); 
                    alert('Erreur serveur: ' + err.message);
                }
            });

            // Initial render
            render();
        })();
    </script>
{% endblock %}