{% extends 'admin/base.html.twig' %}

{% block page_title %}Suggestions{% endblock %}

{% block admin_content %}
<style>
    /* Suggestions admin page styles */
    .suggestions-wrap{ display:flex; gap:20px; align-items:flex-start; }
    .suggestion-manager{ width:320px; }
    .create-row{ display:flex; gap:10px; margin-bottom:12px; align-items:center; }
    .create-row input{ flex:1; padding:8px; border:1px solid #ddd; border-radius:6px; }
    .lists-card{ padding:12px; max-height:520px; overflow:auto; }
    #suggestion-lists li{ padding:8px 6px; display:flex; align-items:center; gap:8px; border-bottom:1px dashed #f0f0f0; }
    #suggestion-lists li img{ width:32px; height:32px; object-fit:cover; border-radius:6px; }
    .select-list{ cursor:pointer; color:#2c3e50; font-weight:600 }
    .suggestion-main{ flex:1; }
    #current-list-title{ margin:0; font-size:1.1em }
    #current-list-actions > button{ margin-left:6px }
    #suggestions-table td:first-child{ width:160px; text-align:center }
    #current-list-preview .menu-item{ padding:12px; border-radius:8px; background:#fff; box-shadow:0 4px 10px rgba(0,0,0,0.06) }
    .btn-outline{ background:transparent; border:1px solid #ddd; color:#2c3e50; padding:8px 10px; border-radius:6px; cursor:pointer }
    .muted{ color:#666 }
    #suggestion-lists small.muted{ color:#666 }
    #suggestion-lists li{ align-items:center }
    #suggestion-lists li .actions { margin-left: auto; display:flex; gap:6px }
    #suggestion-lists li .count { color:#666; font-size:0.9em }

    /* Suggestions table tweaks */
    #suggestions-table td, #suggestions-table th { padding:12px }
    #suggestions-table td:first-child { width:160px; text-align:center }

    /* Preview cards */
    #current-list-preview .preview-grid{ display:grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap:12px }
    #current-list-preview .preview-card{ padding:12px; border-radius:8px; background:#fff; box-shadow:0 4px 10px rgba(0,0,0,0.06); display:flex; flex-direction:column; gap:8px }
    #current-list-preview .preview-card .title{ display:flex; justify-content:space-between; align-items:center; gap:8px; font-weight:700 }
    #current-list-preview .preview-card .price{ color:#D2691E; font-weight:700 }
    #current-list-preview .preview-card .desc{ color:#666; font-size:0.95em }
    .btn-space{ margin-left:6px }
    /* Responsive tweak */
    @media (max-width: 900px){ .suggestions-wrap{ flex-direction:column } .suggestion-manager{ width:100% } }
</style>

<div class="card">
    <h2>Listes de Suggestions</h2>
    <p>Créez des listes de produits recommandés que le client verra sur son tableau de bord.</p>

    <div class="suggestions-wrap">
        <div class="suggestion-manager">
            <div class="create-row">
                <input id="new-list-name" placeholder="Nom de la liste">
                <button id="create-list" class="btn btn-primary btn-sm">Créer</button>
            </div>
            <div class="card lists-card">
                <h4>Listes</h4>
                <ul id="suggestion-lists" style="list-style:none; padding-left:0; margin:0;"></ul>
            </div>
        </div>

        <div class="suggestion-main">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
                <h3 id="current-list-title">Liste : <span id="current-list-name">Aucune</span></h3>
                <div style="margin-left:auto; display:flex; gap:8px; align-items:center;">
                    <label for="select-list-dropdown" style="font-size:0.9em; color:#666;">Choisir la liste :</label>
                    <select id="select-list-dropdown" style="padding:6px; border-radius:6px; border:1px solid #ddd;"></select>
                    <div id="current-list-actions" style="margin-left:8px; display:flex; gap:6px; align-items:center;"></div>
                </div>
            </div>
            <div class="table-responsive">
                <table id="suggestions-table"><thead><tr><th></th><th>Nom</th><th>Catégorie</th><th>Prix</th><th>Stock</th></tr></thead><tbody></tbody></table>
            </div>
            <div id="current-list-preview" style="margin-top:18px;"></div>
        </div>
    </div>
</div>

<script>
        // small on-screen debug panel to show JS errors and actions
        (function(){
            const dbg = document.createElement('div'); dbg.id='debug-panel'; dbg.style.position='fixed'; dbg.style.right='12px'; dbg.style.bottom='12px'; dbg.style.maxWidth='320px'; dbg.style.maxHeight='200px'; dbg.style.overflow='auto'; dbg.style.background='rgba(0,0,0,0.75)'; dbg.style.color='#fff'; dbg.style.padding='8px'; dbg.style.fontSize='12px'; dbg.style.borderRadius='6px'; dbg.style.zIndex='9999'; dbg.style.display='none'; document.body.appendChild(dbg);
            window.showDebug = function(msg){ dbg.style.display='block'; const p=document.createElement('div'); p.textContent = (new Date()).toLocaleTimeString() + ' — ' + msg; dbg.appendChild(p); };
            window.clearDebug = function(){ dbg.innerHTML=''; dbg.style.display='none'; };
            window.addEventListener('error', function(e){ try{ window.showDebug('ERROR: ' + e.message + ' at ' + (e.filename||'') + ':' + (e.lineno||'') ); }catch(_){} });
        })();
// Try to load menu from API first, fallback to localStorage/sample
async function loadMenu(){
    try{
        const res = await fetch('/api/menu-items');
        if(res.ok){
            const data = await res.json();
            // Map API shape to preview menu shape
            const mapped = data.map(it => ({
                id: parseInt(it.id,10),
                name: it.name || '',
                category: it.categorie || '',
                price: it.price !== undefined ? it.price : (it.price_raw||''),
                stock: it.stock || 0,
                description: it.description || '',
                image: it.image || null
            }));
            window._preview_menu = mapped;
            try{ localStorage.setItem('preview_menu', JSON.stringify(mapped)); }catch(e){}
            return;
        }
    }catch(e){
        // ignore network errors and fallback to localStorage
    }

    // fallback to localStorage or sample
    try{
        const stored = JSON.parse(localStorage.getItem('preview_menu')||'null');
        if(stored && Array.isArray(stored)) { window._preview_menu = stored; return; }
    }catch(e){}

    // sample
    window._preview_menu = [{id:1,name:'Espresso',category:'Cafés',price:2.5,stock:45},{id:2,name:'Croissant',category:'Pâtisseries',price:2.0,stock:5},{id:3,name:'Tiramisu',category:'Desserts',price:4.5,stock:0}];
    try{ localStorage.setItem('preview_menu', JSON.stringify(window._preview_menu)); }catch(e){}
}

function readMenu(){ return window._preview_menu || []; }
function readSuggestionLists(){try{return JSON.parse(localStorage.getItem('preview_suggestion_lists')||'null')||[]}catch(e){return[]}}
function saveSuggestionLists(s){localStorage.setItem('preview_suggestion_lists',JSON.stringify(s))}

// migrate old single-list format if present
if(localStorage.getItem('preview_product_suggestions') && !localStorage.getItem('preview_suggestion_lists')){
    try{
        const old = JSON.parse(localStorage.getItem('preview_product_suggestions')||'[]')||[];
        const lists = [{id:1,name:'Suggestions',productIds: old}];
        localStorage.setItem('preview_suggestion_lists', JSON.stringify(lists));
    }catch(e){}
}

// load menu from API (or fallback) before rendering lists
// this populates window._preview_menu and localStorage.preview_menu
// then we render the UI

// initialize suggestions storage if missing
if(!localStorage.getItem('preview_suggestion_lists')){ localStorage.setItem('preview_suggestion_lists', JSON.stringify([])); }

loadMenu().then(()=>{
    renderLists();
    renderCurrentList();
});

let currentListId = null;

function populateListDropdown(){
    const sel = document.getElementById('select-list-dropdown'); sel.innerHTML = '<option value="">-- Aucune --</option>';
    const lists = readSuggestionLists();
    lists.forEach(l=>{ const opt = document.createElement('option'); opt.value = l.id; opt.textContent = l.name; sel.appendChild(opt); });
    sel.value = currentListId || '';
    // assign onchange (replace previous handlers) to avoid duplicate listeners
    sel.onchange = function(){ currentListId = this.value ? parseInt(this.value,10) : null; renderCurrentList(); renderLists(); };
}

function renderLists(){
    const ul=document.getElementById('suggestion-lists'); ul.innerHTML='';
    const lists = readSuggestionLists();
    lists.forEach(l=>{
    const li=document.createElement('li'); li.style.padding='6px 0';
    const pub = l.published ? '<span style="color:green; margin-right:6px; font-weight:600">(Publié)</span>' : '';
    // try to resolve a thumbnail: list.image || first product image from menu
    let thumb = '';
    try{
        if(l.image){ thumb = `<img src="${l.image}" alt="" style="width:28px;height:28px;object-fit:cover;border-radius:4px;margin-right:8px;vertical-align:middle">`; }
        else if(Array.isArray(l.productIds) && l.productIds.length){
            const menu = readMenu();
            const firstWithImage = l.productIds.map(id=> menu.find(m=>m.id===id)).find(Boolean);
            if(firstWithImage && firstWithImage.image){ thumb = `<img src="${firstWithImage.image}" alt="" style="width:28px;height:28px;object-fit:cover;border-radius:4px;margin-right:8px;vertical-align:middle">`; }
        }
    }catch(e){}
    li.innerHTML = `${thumb}${pub}<strong data-id="${l.id}" class="select-list">${escapeHtml(l.name)}</strong> <small class="muted">(${(l.productIds||[]).length})</small> <span class="actions"><button class="btn btn-sm btn-secondary edit-list" data-id="${l.id}">✎</button> <button class="btn btn-sm btn-danger del-list" data-id="${l.id}">🗑</button></span>`;
    ul.appendChild(li);
    });

    document.querySelectorAll('.select-list').forEach(s=>s.addEventListener('click', function(){ currentListId = parseInt(this.dataset.id,10); renderCurrentList(); document.getElementById('select-list-dropdown').value = currentListId; }));
    document.querySelectorAll('.del-list').forEach(b=>b.addEventListener('click', function(){ if(!confirm('Supprimer cette liste ?')) return; const id=parseInt(this.dataset.id,10); let lists=readSuggestionLists(); lists=lists.filter(x=>x.id!==id); saveSuggestionLists(lists); if(currentListId===id) currentListId=null; renderLists(); renderCurrentList(); populateListDropdown(); }));
    document.querySelectorAll('.edit-list').forEach(b=>b.addEventListener('click', function(){ const id=parseInt(this.dataset.id,10); const lists=readSuggestionLists(); const item = lists.find(x=>x.id===id); const name = prompt('Renommer la liste', item.name); if(name){ item.name = name; saveSuggestionLists(lists); renderLists(); renderCurrentList(); populateListDropdown(); } }));
    populateListDropdown();
}

function renderCurrentList(){
    try{
        const lists = readSuggestionLists();
        const list = lists.find(x=>x.id===currentListId);
        const title = document.getElementById('current-list-title');
        const actions = document.getElementById('current-list-actions');
        const nameSpan = document.getElementById('current-list-name');
        const tbody=document.querySelector('#suggestions-table tbody'); tbody.innerHTML='';

        if(!list){
            if(nameSpan) nameSpan.textContent = 'Aucune';
            actions.innerHTML = '';
        } else {
            if(nameSpan) nameSpan.textContent = list.name;
            // keep the existing title element structure (it contains the span with id="current-list-name")
            actions.innerHTML = `
                <button id="clear-list" class="btn btn-secondary btn-sm">Vider la liste</button>
                <button id="publish-current-list" class="btn btn-sm btn-success">Publier</button>
                <button id="edit-current-list" class="btn btn-sm btn-outline">✎ Éditer</button>
                <button id="delete-current-list" class="btn btn-sm btn-danger">🗑 Supprimer</button>
            `;
            // publish/unpublish handler
            document.getElementById('publish-current-list').addEventListener('click', function(){
                try{
                    list.published = !list.published;
                    // if now published show feedback
                    saveSuggestionLists(lists);
                    notifyListsUpdated();
                    renderLists();
                    renderCurrentList();
                    window.showDebug && window.showDebug('Toggled published for list ' + list.id + ' -> ' + !!list.published);
                }catch(e){ console.error(e); }
            });
            document.getElementById('clear-list').addEventListener('click', function(){ if(!confirm('Vider tous les produits de cette liste ?')) return; list.productIds = []; saveSuggestionLists(lists); notifyListsUpdated(); renderCurrentList(); });
            document.getElementById('edit-current-list').addEventListener('click', function(){ const newName = prompt('Renommer la liste', list.name); if(newName){ list.name = newName; saveSuggestionLists(lists); notifyListsUpdated(); renderLists(); renderCurrentList(); populateListDropdown(); } });
            document.getElementById('delete-current-list').addEventListener('click', function(){ if(!confirm('Supprimer cette liste ?')) return; let ns = readSuggestionLists().filter(x=>x.id!==list.id); saveSuggestionLists(ns); currentListId = null; notifyListsUpdated(); renderLists(); renderCurrentList(); populateListDropdown(); });
        }

        const menu = readMenu();
        if(!menu || !Array.isArray(menu) || menu.length===0){
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:20px; color:#666;">Aucun produit disponible</td></tr>';
            return;
        }

        menu.forEach(it=>{
            const tr=document.createElement('tr');
            const inList = list ? ((list.productIds||[]).indexOf(it.id)!==-1) : false;
            const price = it.price || '';
            const actionHtml = list ? (inList ? '<button class="btn btn-secondary btn-sm" disabled>Ajouté</button>' : `<button class="btn btn-primary btn-sm suggest-add" data-id="${it.id}">Ajouter</button>`) : '<button class="btn btn-secondary btn-sm" disabled>Choisir une liste</button>';
            tr.innerHTML = `
                <td>${actionHtml}</td>
                <td>${escapeHtml(it.name||'')}</td>
                <td>${escapeHtml(it.category||'')}</td>
                <td>${escapeHtml(String(price))}</td>
                <td>${escapeHtml(String(it.stock||0))}</td>
            `;
            tbody.appendChild(tr);
        });

        document.querySelectorAll('.suggest-add').forEach(btn=>{
            btn.addEventListener('click', function(e){
                try{
                    if(!currentListId){ showNotification('warning', 'Veuillez sélectionner ou créer une liste d\'abord'); return; }
                    const id = parseInt(this.dataset.id,10);
                    const lists = readSuggestionLists();
                    const target = lists.find(x=>x.id===currentListId);
                    if(!target.productIds) target.productIds = [];
                    if(target.productIds.indexOf(id)===-1){ target.productIds.push(id); saveSuggestionLists(lists); renderCurrentList(); renderLists(); window.showDebug && window.showDebug('Ajouté item ' + id + ' to list ' + currentListId); showNotification('success', 'Produit ajouté à la liste'); }
                }catch(err){ console.error(err); window.showDebug && window.showDebug('Error in add handler: ' + err.message); showNotification('error', 'Erreur lors de l\'ajout'); }
            });
        });

        // render the visual preview of items in the current list below the table
        try{
            const preview = document.getElementById('current-list-preview');
            preview.innerHTML = '';
            if(list && Array.isArray(list.productIds) && list.productIds.length){
                const menuItems = readMenu();
                const products = list.productIds.map(id => menuItems.find(m=>m.id===id)).filter(Boolean);
                const grid = document.createElement('div');
                grid.className = 'preview-grid';
                products.forEach(it => {
                    const card = document.createElement('div');
                    card.className = 'preview-card';
                    const priceText = (typeof it.price === 'number') ? it.price.toFixed(2) + '€' : (it.price || '');
                    card.innerHTML = `
                        <div class="title"><span class="item-name">${escapeHtml(it.name||'')}</span><span class="price">${escapeHtml(priceText)}</span></div>
                        <div class="desc">${escapeHtml(it.description||'')}</div>
                        <div style="text-align:right;"><button class="btn btn-sm btn-danger remove-from-list" data-id="${it.id}">Supprimer</button></div>
                    `;
                    grid.appendChild(card);
                });
                preview.appendChild(grid);

                // wire remove buttons
                preview.querySelectorAll('.remove-from-list').forEach(b=>{
                    b.addEventListener('click', function(){
                        const id = parseInt(this.dataset.id,10);
                        const lists2 = readSuggestionLists();
                        const tgt = lists2.find(x=>x.id===currentListId);
                        if(!tgt) return;
                        tgt.productIds = (tgt.productIds||[]).filter(x=>x!==id);
                        saveSuggestionLists(lists2);
                        renderCurrentList();
                        renderLists();
                    });
                });
            } else {
                preview.innerHTML = '<div style="color:#666; padding:12px; background:#fff; border-radius:8px;">Aucun produit dans cette liste.</div>';
            }
        }catch(err){ console.error('preview render error', err); window.showDebug && window.showDebug('preview render error: ' + err.message); }
    }catch(err){
        console.error(err);
        window.showDebug && window.showDebug('renderCurrentList error: ' + err.message);
    }
}

function createListObject(name){ const lists = readSuggestionLists(); const id = lists.length? Math.max(...lists.map(x=>x.id))+1 : 1; const obj = { id:id, name:name, productIds: [], published: false }; lists.push(obj); saveSuggestionLists(lists); notifyListsUpdated(); return obj; }

document.getElementById('create-list').addEventListener('click', function(){
    const name = document.getElementById('new-list-name').value.trim();
    if(!name) { showNotification('warning', 'Donnez un nom à la liste'); return; }
    const obj = createListObject(name);
    document.getElementById('new-list-name').value='';
    renderLists();
    currentListId = obj.id;
    renderCurrentList();
    showNotification('success', 'Liste créée');
});


// convenience add/edit/delete handlers near the dropdown
function notifyListsUpdated(){ try{ localStorage.setItem('preview_suggestion_lists', JSON.stringify(readSuggestionLists())); localStorage.setItem('preview_suggestion_lists_updated_at', String(Date.now())); }catch(e){}}

// add a small Add button next to dropdown for quick create
(function attachDropdownActions(){
    const container = document.getElementById('current-list-actions');
    if(!container) return;
    const btnAdd = document.createElement('button'); btnAdd.className='btn btn-sm btn-primary'; btnAdd.textContent='Ajouter liste';
    const btnEdit = document.createElement('button'); btnEdit.className='btn btn-sm btn-outline'; btnEdit.textContent='Éditer';
    const btnDel = document.createElement('button'); btnDel.className='btn btn-sm btn-danger'; btnDel.textContent='Supprimer';
    container.appendChild(btnAdd); container.appendChild(btnEdit); container.appendChild(btnDel);

    btnAdd.addEventListener('click', function(){
        // Simulate prompt with notification (or modal)
        const name = window.prompt('Nom de la nouvelle liste');
        if(!name) { showNotification('warning', 'Nom de liste requis'); return; }
        const lists = readSuggestionLists();
        const id = lists.length? Math.max(...lists.map(x=>x.id))+1 : 1;
        lists.push({id:id,name:name,productIds:[]});
        saveSuggestionLists(lists); notifyListsUpdated(); renderLists(); currentListId = id; renderCurrentList(); populateListDropdown();
        showNotification('success', 'Liste ajoutée');
    });
    btnEdit.addEventListener('click', function(){
        if(!currentListId) { showNotification('warning', 'Sélectionnez une liste à éditer'); return; }
        const lists = readSuggestionLists();
        const item = lists.find(x=>x.id===currentListId);
        const name = window.prompt('Renommer la liste', item.name);
        if(name){ item.name = name; saveSuggestionLists(lists); notifyListsUpdated(); renderLists(); renderCurrentList(); populateListDropdown(); showNotification('success', 'Liste renommée'); }
    });
    btnDel.addEventListener('click', function(){
        if(!currentListId) { showNotification('warning', 'Sélectionnez une liste à supprimer'); return; }
        // Simulate confirm with notification (or modal)
        if(!window.confirm('Supprimer la liste sélectionnée ?')) return;
        let lists = readSuggestionLists().filter(x=>x.id!==currentListId);
        saveSuggestionLists(lists); notifyListsUpdated(); currentListId = null; renderLists(); renderCurrentList(); populateListDropdown();
        showNotification('success', 'Liste supprimée');
    });
})();

function escapeHtml(s){ if(!s) return ''; return String(s).replace(/[&<>\"']/g, function(m){ return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[m]; }); }
</script>

{% endblock %}
