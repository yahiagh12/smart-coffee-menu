{% extends 'base.html.twig' %}

{% block title %}{{ menuItem.name }}{% endblock %}

{% block body %}
<h1>{{ menuItem.name }}</h1>
<div class="meta">{{ menuItem.category }} — {{ menuItem.price }}€</div>
<img src="/uploads/menu/{{ menuItem.image }}" alt="{{ menuItem.name }}" style="max-width:200px" />
<p>{{ menuItem.description }}</p>

<a href="{{ path('menu_list') }}">Back to menu</a>
{% endblock %}
