{% extends "base_notification.html.twig" %}

{% block title %}Demander un Événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Form card styling matching the client dashboard theme */
        .card.form-card {
            max-width: 800px;
            margin: 0 auto 30px auto;
            padding: 32px 28px;
            border-radius: 15px;
            box-shadow: 0 4px 24px rgba(44,62,80,0.08);
            background: #fff;
        }

        .card.form-card h2 {
            color: #34495e;
            margin-bottom: 20px;
        }

        .form-group label {
            font-weight: 600;
            margin-bottom: 6px;
            display: block;
            color: #2c3e50;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 1em;
            margin-bottom: 16px;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #3498db;
            box-shadow: 0 0 5px rgba(52, 152, 219, 0.3);
            outline: none;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 6px;
            font-size: 1em;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-block;
        }

        .btn-primary {
            background: #3498db;
            color: #fff;
            border: none;
        }

        .btn-primary:hover {
            background: #2980b9;
        }

        .btn-cancel {
            background: #95a5a6;
            color: #fff;
            border: none;
        }

        .btn-cancel:hover {
            background: #7f8c8d;
        }

        .note {
            margin-top: 16px;
            font-size: 0.9em;
            color: #555;
        }

        @media (max-width: 900px) {
            .card.form-card {
                padding: 20px;
                margin: 0 10px 30px 10px;
            }
        }
    </style>
{% endblock %}

{% block client_content %}
    <div style="max-width:800px;margin:20px auto;padding:0 20px;">
        <div class="card form-card">
            <h2>📝 Demander un Événement</h2>
            <form method="post" enctype="multipart/form-data" action="/client/event-request">
                <div class="form-group">
                    <label for="event_name">Nom de l'événement</label>
                    <input type="text" id="event_name" name="event_name" required />
                </div>
                <div class="form-group">
                    <label for="event_date">Date</label>
                    <input type="date" id="event_date" name="event_date" required />
                </div>
                <div class="form-group">
                    <label for="event_description">Description</label>
                    <textarea id="event_description" name="event_description" rows="6" required></textarea>
                </div>
                <div class="form-group">
                    <label for="event_image">Image (optionnelle)</label>
                    <input type="file" id="event_image" name="image" accept="image/*" />
                </div>
                <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
                    <button type="submit" class="btn btn-primary">✅ Envoyer la demande</button>
                    {% if app.user is defined and app.user is not null %}
                        <a href="{{ path('client_home') }}" class="btn btn-cancel">🚫 Annuler</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-cancel">🚫 Annuler</a>
                    {% endif %}
                </div>
            </form>
            <div class="note">
                Votre demande sera transmise à l'administrateur pour approbation. Vous recevrez une notification une fois la décision prise.
            </div>
        </div>
    </div>
{% endblock %}
