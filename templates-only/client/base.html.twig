{% extends "base_notification.html.twig" %}

{% block title %}Mon Espace{% endblock %}

{% block stylesheets %}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f5f5f5;
        color: #333;
        min-height: 100vh;
    }

    .client-dashboard {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar - Matched to Admin */
    .client-sidebar {
        width: 260px;
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        color: white;
        padding: 20px 0;
        position: fixed;
        height: 100vh;
        overflow-y: auto;
        box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
        display: flex;
        flex-direction: column;
    }

    .client-sidebar h2 {
        padding: 20px 20px 10px;
        font-size: 1.5em;
        border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 20px;
    }

    .client-sidebar a {
        display: block;
        padding: 12px 20px;
        color: #ecf0f1;
        text-decoration: none;
        transition: all 0.3s;
        border-left: 4px solid transparent;
        margin: 4px 0;
    }

    .client-sidebar a:hover {
        background: rgba(255, 255, 255, 0.1);
        border-left-color: #3498db;
        padding-left: 25px;
    }

    .client-sidebar a.active {
        background: rgba(52, 152, 219, 0.2);
        border-left-color: #3498db;
        color: #3498db;
    }

    .menu-section {
        margin-top: 20px;
    }

    .menu-section-title {
        padding: 10px 20px;
        font-size: 0.85em;
        color: #95a5a6;
        text-transform: uppercase;
        font-weight: bold;
        letter-spacing: 1px;
    }

    /* Main Content - Matched to Admin */
    .client-main {
        margin-left: 260px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .client-header {
        background: white;
        padding: 20px 30px;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    .client-header h1 {
        font-size: 1.8em;
        color: #2c3e50;
    }

    .client-header-right {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .client-header-right a {
        color: #3498db;
        text-decoration: none;
        padding: 8px 15px;
        border-radius: 5px;
        transition: background 0.3s;
    }

    .client-header-right a:hover {
        background: #ecf0f1;
    }

    .client-content {
        flex: 1;
        padding: 30px;
    }

    /* Profile Card - Updated to match Admin Cards */
    .profile-card {
        background: white;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .profile-pic {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #3498db;
    }

    .profile-info h2 {
        color: #2c3e50;
        margin-bottom: 8px;
        font-size: 1.5em;
    }

    .profile-info p {
        color: #555;
        margin-bottom: 6px;
    }

    /* Summary Cards - Matched to Admin Stats Grid */
    .summary-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .card {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border-left: 5px solid #3498db;
        text-align: center;
    }

    .card.success {
        border-left-color: #27ae60;
    }

    .card.warning {
        border-left-color: #f39c12;
    }

    .card.danger {
        border-left-color: #e74c3c;
    }

    .card h3 {
        color: #95a5a6;
        font-size: 0.9em;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    .card p {
        font-size: 2.5em;
        font-weight: bold;
        color: #2c3e50;
    }

    /* Sections - Matched to Admin */
    .section {
        background: white;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .section h3 {
        color: #2c3e50;
        margin-bottom: 20px;
        font-size: 1.5em;
    }

    .event-list {
        list-style: none;
        padding: 0;
    }

    .event-list li {
        background: #f8f9fa;
        border-radius: 5px;
        margin-bottom: 10px;
        padding: 15px;
        border-left: 4px solid #3498db;
    }

    /* Buttons - Matched to Admin */
    .btn {
        display: inline-block;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 1em;
        text-decoration: none;
        transition: all 0.3s;
    }

    .btn-primary {
        background: #3498db;
        color: white;
    }

    .btn-primary:hover {
        background: #2980b9;
        transform: translateY(-2px);
    }

    .edit-profile-btn {
        background: #3498db;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 10px 20px;
        cursor: pointer;
        margin-top: 10px;
        text-decoration: none;
        display: inline-block;
    }

    .edit-profile-btn:hover {
        background: #2980b9;
        transform: translateY(-2px);
    }

    .add-btn {
        background: #3498db;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 10px 20px;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 18px;
    }

    .add-btn:hover {
        background: #2980b9;
        transform: translateY(-2px);
    }

    /* Responsive - Matched to Admin */
    @media (max-width: 768px) {
        .client-sidebar {
            width: 70px;
            padding: 10px 0;
        }

        .client-sidebar h2 {
            font-size: 1em;
            padding: 10px;
            text-align: center;
        }

        .client-sidebar a {
            padding: 12px;
            text-align: center;
            font-size: 0;
        }

        .client-sidebar a::before {
            font-size: 1.2em;
        }

        .client-main {
            margin-left: 70px;
        }

        .client-header {
            flex-direction: column;
            gap: 10px;
        }

        .summary-cards {
            grid-template-columns: 1fr;
        }

        .profile-card {
            flex-direction: column;
            text-align: center;
            gap: 15px;
        }
    }
</style>
{% endblock %}

{% block body %}
{% set client = client is defined ? client : {} %}

<div class="client-dashboard">

    <!-- Sidebar -->
    <aside class="client-sidebar">
        <h2>☕ Mon Espace</h2>
        
        <a href="/view?t=client/account.html.twig" class="active">📊 Tableau de bord</a>
        <a href="/view?t=client/event_request_form.html.twig">📝 Demander un Événement</a>
        
        <div class="menu-section">
            <div class="menu-section-title">Compte</div>
            {# Removed Paramètres link per request #}
            <a href="/view?t=auth/login.html.twig">🚪 Déconnexion</a>
        </div>
    </aside>

    <!-- Main content -->
    <main class="client-main">
        <!-- Header -->
        <header class="client-header">
            <h1>Mon Tableau de Bord</h1>
            <div class="client-header-right">
                <span>👤 Client</span>
                <a href="{{ path('app_cafe_home') }}">🏠 Accueil Café</a>
            </div>
        </header>

        <!-- Content -->
        <section class="client-content">
            {% block client_content %}{% endblock %}
        </section>
    </main>
</div>

{% endblock %}